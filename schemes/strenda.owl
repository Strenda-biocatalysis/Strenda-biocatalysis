#########################################################
# Class: SelectivityResults
#########################################################
# Selectivity measurements including
stereoselectivity, enantioselectivity, and other
selectivity parameters.
#########################################################

stbc:SelectivityResults a owl:Class ;
  rdfs:comment "Selectivity measurements including stereoselectivity, enantioselectivity, and other selectivity parameters." .

stbc:SelectivityResults
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:Stereoselectivity ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:Enantioselectivity ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:EnantiomericExcess ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:DiastereomericExcess ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:IsomericContent ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:Chemoselectivity ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:Regioselectivity ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SelectivityResults:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: SelectivityResults:Stereoselectivity
#########################################################

SelectivityResults:Stereoselectivity
  a owl:DatatypeProperty;
  rdfs:domain stbc:SelectivityResults ;
