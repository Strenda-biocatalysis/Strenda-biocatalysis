@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix stbc: <https://biocat.strenda.io#> .


#########################################################
# Class-scoped prefixes
#########################################################

@prefix StrendaBiocatalysis: <https://biocat.strenda.io#StrendaBiocatalysis/> .
@prefix ReactionConditions: <https://biocat.strenda.io#ReactionConditions/> .
@prefix ReactorSetup: <https://biocat.strenda.io#ReactorSetup/> .
@prefix FlowConditions: <https://biocat.strenda.io#FlowConditions/> .
@prefix ReactionSystem: <https://biocat.strenda.io#ReactionSystem/> .
@prefix MonoliquidSystem: <https://biocat.strenda.io#MonoliquidSystem/> .
@prefix MultiphasicSystem: <https://biocat.strenda.io#MultiphasicSystem/> .
@prefix Phase: <https://biocat.strenda.io#Phase/> .
@prefix TemperatureProfile: <https://biocat.strenda.io#TemperatureProfile/> .
@prefix ProfilePoint: <https://biocat.strenda.io#ProfilePoint/> .
@prefix Gradient: <https://biocat.strenda.io#Gradient/> .
@prefix PHProfile: <https://biocat.strenda.io#PHProfile/> .
@prefix PHPoint: <https://biocat.strenda.io#PHPoint/> .
@prefix PHGradient: <https://biocat.strenda.io#PHGradient/> .
@prefix PHDetection: <https://biocat.strenda.io#PHDetection/> .
@prefix UnitDefinition: <https://biocat.strenda.io#UnitDefinition/> .
@prefix BaseUnit: <https://biocat.strenda.io#BaseUnit/> .
@prefix Quantity: <https://biocat.strenda.io#Quantity/> .
@prefix StorageConditions: <https://biocat.strenda.io#StorageConditions/> .
@prefix VesselAndMixing: <https://biocat.strenda.io#VesselAndMixing/> .
@prefix Vessel: <https://biocat.strenda.io#Vessel/> .
@prefix Closure: <https://biocat.strenda.io#Closure/> .
@prefix ReactorSpecifics: <https://biocat.strenda.io#ReactorSpecifics/> .
@prefix GasHandling: <https://biocat.strenda.io#GasHandling/> .
@prefix Mixing: <https://biocat.strenda.io#Mixing/> .
@prefix ShakingMixing: <https://biocat.strenda.io#ShakingMixing/> .
@prefix MechanicalMixing: <https://biocat.strenda.io#MechanicalMixing/> .
@prefix StirBar: <https://biocat.strenda.io#StirBar/> .
@prefix FluidImpelledMixing: <https://biocat.strenda.io#FluidImpelledMixing/> .
@prefix Biocatalyst: <https://biocat.strenda.io#Biocatalyst/> .
@prefix BiocatalystIdentity: <https://biocat.strenda.io#BiocatalystIdentity/> .
@prefix SequenceInfo: <https://biocat.strenda.io#SequenceInfo/> .
@prefix BiocatalystSource: <https://biocat.strenda.io#BiocatalystSource/> .
@prefix PurchasedDetails: <https://biocat.strenda.io#PurchasedDetails/> .
@prefix SelfProducedDetails: <https://biocat.strenda.io#SelfProducedDetails/> .
@prefix BiocatalystApplication: <https://biocat.strenda.io#BiocatalystApplication/> .
@prefix Concentration: <https://biocat.strenda.io#Concentration/> .
@prefix Activity: <https://biocat.strenda.io#Activity/> .
@prefix ApplicationWorkflowDetails: <https://biocat.strenda.io#ApplicationWorkflowDetails/> .
@prefix Immobilization: <https://biocat.strenda.io#Immobilization/> .
@prefix ExperimentalResults: <https://biocat.strenda.io#ExperimentalResults/> .
@prefix KineticResults: <https://biocat.strenda.io#KineticResults/> .
@prefix InhibitionParameters: <https://biocat.strenda.io#InhibitionParameters/> .
@prefix YieldAndConversionResults: <https://biocat.strenda.io#YieldAndConversionResults/> .
@prefix ActivityResults: <https://biocat.strenda.io#ActivityResults/> .
@prefix SelectivityResults: <https://biocat.strenda.io#SelectivityResults/> .
@prefix ThermodynamicResults: <https://biocat.strenda.io#ThermodynamicResults/> .
@prefix Sampling: <https://biocat.strenda.io#Sampling/> .
@prefix SamplingStrategy: <https://biocat.strenda.io#SamplingStrategy/> .
@prefix Sample: <https://biocat.strenda.io#Sample/> .
@prefix SamplePreprocessing: <https://biocat.strenda.io#SamplePreprocessing/> .
@prefix OperationMode: <https://biocat.strenda.io#OperationMode/> .
@prefix FeedingStrategy: <https://biocat.strenda.io#FeedingStrategy/> .
@prefix ReactionComponent: <https://biocat.strenda.io#ReactionComponent/> .
@prefix ComponentIdentity: <https://biocat.strenda.io#ComponentIdentity/> .
@prefix AmountConcentration: <https://biocat.strenda.io#AmountConcentration/> .
@prefix Provenance: <https://biocat.strenda.io#Provenance/> .
@prefix SolubilityLimit: <https://biocat.strenda.io#SolubilityLimit/> .

#########################################################
# Ontology
#########################################################

stbc:ontology a owl:Ontology ;
  rdfs:comment "Ontology generated from the stbc data model." .

#########################################################
# Class: StrendaBiocatalysis
#########################################################
# Specification of the Strenda-biocatalysis
project.
#########################################################

stbc:StrendaBiocatalysis a owl:Class ;
  rdfs:comment "Specification of the Strenda-biocatalysis project." .

stbc:StrendaBiocatalysis
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:Biocatalyst ;
      owl:allValuesFrom stbc:Biocatalyst
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:ReactionComponents ;
      owl:allValuesFrom stbc:ReactionComponent
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:OperationMode ;
      owl:allValuesFrom stbc:OperationMode
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:ReactionConditions ;
      owl:allValuesFrom stbc:ReactionConditions
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:Results ;
      owl:allValuesFrom stbc:ExperimentalResults
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:Sampling ;
      owl:allValuesFrom stbc:Sampling
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StrendaBiocatalysis:VesselsAndMixing ;
      owl:allValuesFrom stbc:VesselAndMixing
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: StrendaBiocatalysis:Biocatalyst
#########################################################

StrendaBiocatalysis:Biocatalyst
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:Biocatalyst ;
  rdfs:label "StrendaBiocatalysis/Biocatalyst" ;
  rdfs:comment "Biocatalyst used in the Strenda-biocatalysis project." .

#########################################################
# Property: StrendaBiocatalysis:ReactionComponents
#########################################################

StrendaBiocatalysis:ReactionComponents
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:ReactionComponent ;
  rdfs:label "StrendaBiocatalysis/ReactionComponents" ;
  rdfs:comment "Components used in the Strenda-biocatalysis project." .

#########################################################
# Property: StrendaBiocatalysis:OperationMode
#########################################################

StrendaBiocatalysis:OperationMode
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:OperationMode ;
  rdfs:label "StrendaBiocatalysis/OperationMode" ;
  rdfs:comment "Operation mode used in the Strenda-biocatalysis project." .

#########################################################
# Property: StrendaBiocatalysis:ReactionConditions
#########################################################

StrendaBiocatalysis:ReactionConditions
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:ReactionConditions ;
  rdfs:label "StrendaBiocatalysis/ReactionConditions" ;
  rdfs:comment "Reaction conditions used in the Strenda-biocatalysis project." .

#########################################################
# Property: StrendaBiocatalysis:Results
#########################################################

StrendaBiocatalysis:Results
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:ExperimentalResults ;
  rdfs:label "StrendaBiocatalysis/Results" ;
  rdfs:comment "Results used in the Strenda-biocatalysis project." .

#########################################################
# Property: StrendaBiocatalysis:Sampling
#########################################################

StrendaBiocatalysis:Sampling
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:Sampling ;
  rdfs:label "StrendaBiocatalysis/Sampling" ;
  rdfs:comment "Sampling used in the Strenda-biocatalysis project." .

#########################################################
# Property: StrendaBiocatalysis:VesselsAndMixing
#########################################################

StrendaBiocatalysis:VesselsAndMixing
  a owl:ObjectProperty;
  rdfs:domain stbc:StrendaBiocatalysis ;
  rdfs:range stbc:VesselAndMixing ;
  rdfs:label "StrendaBiocatalysis/VesselsAndMixing" ;
  rdfs:comment "Vessel and mixing configuration used in the Strenda-biocatalysis project." .

#########################################################
# Class: ReactionConditions
#########################################################
# Comprehensive specification of the physical and
chemical conditions under which a biocatalytic
reaction is performed, including reactor setup,
reaction system characteristics, temperature and
pH profiles.
#########################################################

stbc:ReactionConditions a owl:Class ;
  rdfs:comment "Comprehensive specification of the physical and chemical conditions under which a biocatalytic reaction is performed, including reactor setup, reaction system characteristics, temperature and pH profiles." .

stbc:ReactionConditions
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ReactionConditions:Reactor ;
      owl:allValuesFrom stbc:ReactorSetup
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionConditions:System ;
      owl:allValuesFrom stbc:ReactionSystem
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionConditions:Phases ;
      owl:allValuesFrom stbc:Phase
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionConditions:Temperature ;
      owl:allValuesFrom stbc:TemperatureProfile
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionConditions:PH ;
      owl:allValuesFrom stbc:PHProfile
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionConditions:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: ReactionConditions:Reactor
#########################################################

ReactionConditions:Reactor
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionConditions ;
  rdfs:range stbc:ReactorSetup ;
  rdfs:label "ReactionConditions/Reactor" ;
  rdfs:comment "Configuration and specifications of the reactor used for the biocatalytic reaction." .

#########################################################
# Property: ReactionConditions:System
#########################################################

ReactionConditions:System
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionConditions ;
  rdfs:range stbc:ReactionSystem ;
  rdfs:label "ReactionConditions/System" ;
  rdfs:comment "Characterization of the reaction system as monoliquid or multiphasic." .

#########################################################
# Property: ReactionConditions:Phases
#########################################################

ReactionConditions:Phases
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionConditions ;
  rdfs:range stbc:Phase ;
  rdfs:label "ReactionConditions/Phases" ;
  rdfs:comment "Individual phases present in the reaction system (liquid, solid, gas)." .

#########################################################
# Property: ReactionConditions:Temperature
#########################################################

ReactionConditions:Temperature
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionConditions ;
  rdfs:range stbc:TemperatureProfile ;
  rdfs:label "ReactionConditions/Temperature" ;
  rdfs:comment "Temperature conditions throughout the reaction, which can be constant, event-based, or follow a gradient." .

#########################################################
# Property: ReactionConditions:PH
#########################################################

ReactionConditions:PH
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionConditions ;
  rdfs:range stbc:PHProfile ;
  rdfs:label "ReactionConditions/PH" ;
  rdfs:comment "pH conditions throughout the reaction, which can be constant, event-based, or follow a gradient." .

#########################################################
# Property: ReactionConditions:Notes
#########################################################

ReactionConditions:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactionConditions ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ReactionConditions/Notes" ;
  rdfs:comment "Additional notes or comments about the reaction conditions." .

#########################################################
# Class: ReactorSetup
#########################################################
# Configuration and operational parameters of the
reactor system used for the biocatalytic reaction.
#########################################################

stbc:ReactorSetup a owl:Class ;
  rdfs:comment "Configuration and operational parameters of the reactor system used for the biocatalytic reaction." .

stbc:ReactorSetup
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ReactorSetup:ReactorType ;
      owl:onDataRange xsd:ReactorType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactorSetup:Flow ;
      owl:allValuesFrom stbc:FlowConditions
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactorSetup:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: ReactorSetup:ReactorType
#########################################################

ReactorSetup:ReactorType
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactorSetup ;
  rdfs:range xsd:ReactorType ;
  rdfs:label "ReactorSetup/ReactorType" ;
  rdfs:comment "Type of reactor configuration used (well-mixed or tubular flow)." .

#########################################################
# Property: ReactorSetup:Flow
#########################################################

ReactorSetup:Flow
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactorSetup ;
  rdfs:range stbc:FlowConditions ;
  rdfs:label "ReactorSetup/Flow" ;
  rdfs:comment "Flow rate specifications for continuous or fed-batch operations." .

#########################################################
# Property: ReactorSetup:Notes
#########################################################

ReactorSetup:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactorSetup ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ReactorSetup/Notes" ;
  rdfs:comment "Additional notes about the reactor setup." .

#########################################################
# Class: FlowConditions
#########################################################
# Specifications for flow rates in continuous or
fed-batch reactor operations.
#########################################################

stbc:FlowConditions a owl:Class ;
  rdfs:comment "Specifications for flow rates in continuous or fed-batch reactor operations." .

stbc:FlowConditions
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty FlowConditions:FlowRate ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FlowConditions:FlowRateUnit ;
      owl:allValuesFrom stbc:UnitDefinition
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: FlowConditions:FlowRate
#########################################################

FlowConditions:FlowRate
  a owl:DatatypeProperty;
  rdfs:domain stbc:FlowConditions ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "FlowConditions/FlowRate" ;
  rdfs:comment "Numerical value of the flow rate." .

#########################################################
# Property: FlowConditions:FlowRateUnit
#########################################################

FlowConditions:FlowRateUnit
  a owl:ObjectProperty;
  rdfs:domain stbc:FlowConditions ;
  rdfs:range stbc:UnitDefinition ;
  rdfs:label "FlowConditions/FlowRateUnit" ;
  rdfs:comment "Unit of measurement for the flow rate." .

#########################################################
# Class: ReactionSystem
#########################################################
# Characterization of the reaction system based on
the number and types of phases present.
#########################################################

stbc:ReactionSystem a owl:Class ;
  rdfs:comment "Characterization of the reaction system based on the number and types of phases present." .

stbc:ReactionSystem
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ReactionSystem:SystemType ;
      owl:onDataRange xsd:SystemType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionSystem:Monoliquid ;
      owl:allValuesFrom stbc:MonoliquidSystem
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionSystem:Multiphasic ;
      owl:allValuesFrom stbc:MultiphasicSystem
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionSystem:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: ReactionSystem:SystemType
#########################################################

ReactionSystem:SystemType
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactionSystem ;
  rdfs:range xsd:SystemType ;
  rdfs:label "ReactionSystem/SystemType" ;
  rdfs:comment "Classification of the system as monoliquid or multiphasic." .

#########################################################
# Property: ReactionSystem:Monoliquid
#########################################################

ReactionSystem:Monoliquid
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionSystem ;
  rdfs:range stbc:MonoliquidSystem ;
  rdfs:label "ReactionSystem/Monoliquid" ;
  rdfs:comment "Specifications for single-phase liquid systems." .

#########################################################
# Property: ReactionSystem:Multiphasic
#########################################################

ReactionSystem:Multiphasic
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionSystem ;
  rdfs:range stbc:MultiphasicSystem ;
  rdfs:label "ReactionSystem/Multiphasic" ;
  rdfs:comment "Specifications for systems containing multiple phases." .

#########################################################
# Property: ReactionSystem:Notes
#########################################################

ReactionSystem:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactionSystem ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ReactionSystem/Notes" ;
  rdfs:comment "Additional notes about the reaction system." .

#########################################################
# Class: MonoliquidSystem
#########################################################
# Specifications for single-phase liquid reaction
systems.
#########################################################

stbc:MonoliquidSystem a owl:Class ;
  rdfs:comment "Specifications for single-phase liquid reaction systems." .

stbc:MonoliquidSystem
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty MonoliquidSystem:SolventDescription ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MonoliquidSystem:IonicStrength ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MonoliquidSystem:FurtherAdditives ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MonoliquidSystem:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: MonoliquidSystem:SolventDescription
#########################################################

MonoliquidSystem:SolventDescription
  a owl:DatatypeProperty;
  rdfs:domain stbc:MonoliquidSystem ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MonoliquidSystem/SolventDescription" ;
  rdfs:comment "Detailed description of the solvent or solvent mixture used." .

#########################################################
# Property: MonoliquidSystem:IonicStrength
#########################################################

MonoliquidSystem:IonicStrength
  a owl:ObjectProperty;
  rdfs:domain stbc:MonoliquidSystem ;
  rdfs:range stbc:Quantity ;
  rdfs:label "MonoliquidSystem/IonicStrength" ;
  rdfs:comment "Ionic strength of the solution, affecting enzyme activity and stability." .

#########################################################
# Property: MonoliquidSystem:FurtherAdditives
#########################################################

MonoliquidSystem:FurtherAdditives
  a owl:DatatypeProperty;
  rdfs:domain stbc:MonoliquidSystem ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MonoliquidSystem/FurtherAdditives" ;
  rdfs:comment "Description of any additional additives present in the system." .

#########################################################
# Property: MonoliquidSystem:Notes
#########################################################

MonoliquidSystem:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:MonoliquidSystem ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MonoliquidSystem/Notes" ;
  rdfs:comment "Additional notes about the monoliquid system." .

#########################################################
# Class: MultiphasicSystem
#########################################################
# Specifications for reaction systems containing
multiple distinct phases.
#########################################################

stbc:MultiphasicSystem a owl:Class ;
  rdfs:comment "Specifications for reaction systems containing multiple distinct phases." .

stbc:MultiphasicSystem
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty MultiphasicSystem:PhasesNumber ;
      owl:onDataRange xsd:xsd:integer
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MultiphasicSystem:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: MultiphasicSystem:PhasesNumber
#########################################################

MultiphasicSystem:PhasesNumber
  a owl:DatatypeProperty;
  rdfs:domain stbc:MultiphasicSystem ;
  rdfs:range xsd:xsd:integer ;
  rdfs:label "MultiphasicSystem/PhasesNumber" ;
  rdfs:comment "Total number of distinct phases present in the system." .

#########################################################
# Property: MultiphasicSystem:Notes
#########################################################

MultiphasicSystem:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:MultiphasicSystem ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MultiphasicSystem/Notes" ;
  rdfs:comment "Additional notes about the multiphasic system." .

#########################################################
# Class: Phase
#########################################################
# Specification of individual phases within the
reaction system.
#########################################################

stbc:Phase a owl:Class ;
  rdfs:comment "Specification of individual phases within the reaction system." .

stbc:Phase
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Phase:PhaseType ;
      owl:onDataRange xsd:PhaseType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Phase:MaterialDescription ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Phase:Amount ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Phase:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: Phase:PhaseType
#########################################################

Phase:PhaseType
  a owl:DatatypeProperty;
  rdfs:domain stbc:Phase ;
  rdfs:range xsd:PhaseType ;
  rdfs:label "Phase/PhaseType" ;
  rdfs:comment "Physical state of the phase (liquid, solid, or gas)." .

#########################################################
# Property: Phase:MaterialDescription
#########################################################

Phase:MaterialDescription
  a owl:DatatypeProperty;
  rdfs:domain stbc:Phase ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Phase/MaterialDescription" ;
  rdfs:comment "Detailed description of the materials comprising this phase." .

#########################################################
# Property: Phase:Amount
#########################################################

Phase:Amount
  a owl:ObjectProperty;
  rdfs:domain stbc:Phase ;
  rdfs:range stbc:Quantity ;
  rdfs:label "Phase/Amount" ;
