# Property: ApplicationWorkflowDetails:CellDisruptionProcess
#########################################################

ApplicationWorkflowDetails:CellDisruptionProcess
  a owl:DatatypeProperty;
  rdfs:domain stbc:ApplicationWorkflowDetails ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ApplicationWorkflowDetails/CellDisruptionProcess" ;
  rdfs:comment "Method used to disrupt cells if working with whole cell preparations." .

#########################################################
# Property: ApplicationWorkflowDetails:HarvestingMethod
#########################################################

ApplicationWorkflowDetails:HarvestingMethod
  a owl:DatatypeProperty;
  rdfs:domain stbc:ApplicationWorkflowDetails ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ApplicationWorkflowDetails/HarvestingMethod" ;
  rdfs:comment "Method used to harvest cells or enzyme from the production system." .

#########################################################
