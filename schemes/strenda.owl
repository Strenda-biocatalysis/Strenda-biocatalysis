#########################################################

ThermodynamicResults:EnthalpyChange
  a owl:DatatypeProperty;
  rdfs:domain stbc:ThermodynamicResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ThermodynamicResults/EnthalpyChange" ;
  rdfs:comment "Enthalpy change (ΔH) for the reaction." .

#########################################################
# Property: ThermodynamicResults:EntropyChange
#########################################################

ThermodynamicResults:EntropyChange
  a owl:DatatypeProperty;
  rdfs:domain stbc:ThermodynamicResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ThermodynamicResults/EntropyChange" ;
  rdfs:comment "Entropy change (ΔS) for the reaction." .

#########################################################
# Property: ThermodynamicResults:Notes
#########################################################

ThermodynamicResults:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:ThermodynamicResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ThermodynamicResults/Notes" ;
  rdfs:comment "Additional notes about thermodynamic measurements." .

#########################################################
# Class: Sampling
#########################################################
# Specification for sampling procedures and sample
collection during enzymatic reactions.
#########################################################

stbc:Sampling a owl:Class ;
  rdfs:comment "Specification for sampling procedures and sample collection during enzymatic reactions." .

stbc:Sampling
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Sampling:SamplingApplied ;
      owl:onDataRange xsd:xsd:boolean
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sampling:Strategy ;
      owl:allValuesFrom stbc:SamplingStrategy
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sampling:Samples ;
      owl:allValuesFrom stbc:Sample
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sampling:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: Sampling:SamplingApplied
#########################################################

Sampling:SamplingApplied
  a owl:DatatypeProperty;
  rdfs:domain stbc:Sampling ;
  rdfs:range xsd:xsd:boolean ;
  rdfs:label "Sampling/SamplingApplied" ;
  rdfs:comment "Indicates whether physical sampling was performed at all." .

#########################################################
# Property: Sampling:Strategy
#########################################################

Sampling:Strategy
  a owl:ObjectProperty;
  rdfs:domain stbc:Sampling ;
  rdfs:range stbc:SamplingStrategy ;
  rdfs:label "Sampling/Strategy" ;
  rdfs:comment "Details about the sampling strategy and methodology used." .

#########################################################
# Property: Sampling:Samples
#########################################################

Sampling:Samples
  a owl:ObjectProperty;
  rdfs:domain stbc:Sampling ;
  rdfs:range stbc:Sample ;
  rdfs:label "Sampling/Samples" ;
  rdfs:comment "Collection of individual samples taken during the reaction." .

#########################################################
# Property: Sampling:Notes
#########################################################

Sampling:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:Sampling ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Sampling/Notes" ;
  rdfs:comment "Additional notes or comments about the sampling procedure." .

#########################################################
# Class: SamplingStrategy
#########################################################
# Strategy and methodology for collecting samples
during the reaction process.
#########################################################

stbc:SamplingStrategy a owl:Class ;
  rdfs:comment "Strategy and methodology for collecting samples during the reaction process." .

stbc:SamplingStrategy
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty SamplingStrategy:StrategyType ;
      owl:onDataRange xsd:SamplingStrategyType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplingStrategy:MixingDuringSampling ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplingStrategy:VesselOpened ;
      owl:onDataRange xsd:xsd:boolean
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplingStrategy:GasPhase ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplingStrategy:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: SamplingStrategy:StrategyType
#########################################################

SamplingStrategy:StrategyType
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplingStrategy ;
  rdfs:range xsd:SamplingStrategyType ;
  rdfs:label "SamplingStrategy/StrategyType" ;
  rdfs:comment "Type of sampling strategy employed (default or specialized)." .

#########################################################
# Property: SamplingStrategy:MixingDuringSampling
#########################################################

SamplingStrategy:MixingDuringSampling
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplingStrategy ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SamplingStrategy/MixingDuringSampling" ;
  rdfs:comment "Description of mixing conditions maintained during sample collection." .

#########################################################
# Property: SamplingStrategy:VesselOpened
#########################################################

SamplingStrategy:VesselOpened
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplingStrategy ;
  rdfs:range xsd:xsd:boolean ;
  rdfs:label "SamplingStrategy/VesselOpened" ;
  rdfs:comment "Indicates whether the reaction vessel was opened during sampling." .

#########################################################
# Property: SamplingStrategy:GasPhase
#########################################################

SamplingStrategy:GasPhase
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplingStrategy ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SamplingStrategy/GasPhase" ;
  rdfs:comment "Description of gas phase conditions or handling during sampling." .

#########################################################
# Property: SamplingStrategy:Notes
#########################################################

SamplingStrategy:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplingStrategy ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SamplingStrategy/Notes" ;
  rdfs:comment "Additional notes about the sampling strategy." .

#########################################################
# Class: Sample
#########################################################
# Individual sample collected at a specific time
point from a specific phase of the reaction.
#########################################################

stbc:Sample a owl:Class ;
  rdfs:comment "Individual sample collected at a specific time point from a specific phase of the reaction." .

stbc:Sample
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Sample:Time ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sample:TimeUnit ;
      owl:allValuesFrom stbc:UnitDefinition
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sample:Amount ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sample:Phase ;
      owl:onDataRange xsd:PhaseType
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sample:BiocatalystInSample ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sample:Preprocessing ;
      owl:allValuesFrom stbc:SamplePreprocessing
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Sample:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: Sample:Time
#########################################################

Sample:Time
  a owl:DatatypeProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "Sample/Time" ;
  rdfs:comment "Time point at which the sample was collected." .

#########################################################
# Property: Sample:TimeUnit
#########################################################

Sample:TimeUnit
  a owl:ObjectProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range stbc:UnitDefinition ;
  rdfs:label "Sample/TimeUnit" ;
  rdfs:comment "Unit of measurement for the sampling time." .

#########################################################
# Property: Sample:Amount
#########################################################

Sample:Amount
  a owl:ObjectProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range stbc:Quantity ;
  rdfs:label "Sample/Amount" ;
  rdfs:comment "Amount or volume of sample collected." .

#########################################################
# Property: Sample:Phase
#########################################################

Sample:Phase
  a owl:DatatypeProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range xsd:PhaseType ;
  rdfs:label "Sample/Phase" ;
  rdfs:comment "Phase from which the sample was collected (liquid, solid, gas, etc.)." .

#########################################################
# Property: Sample:BiocatalystInSample
#########################################################

Sample:BiocatalystInSample
  a owl:DatatypeProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Sample/BiocatalystInSample" ;
  rdfs:comment "Description of biocatalyst presence or handling in the sample." .

#########################################################
# Property: Sample:Preprocessing
#########################################################

Sample:Preprocessing
  a owl:ObjectProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range stbc:SamplePreprocessing ;
  rdfs:label "Sample/Preprocessing" ;
  rdfs:comment "Any preprocessing steps applied to the sample before analysis." .

#########################################################
# Property: Sample:Notes
#########################################################

Sample:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:Sample ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Sample/Notes" ;
  rdfs:comment "Additional notes about the individual sample." .

#########################################################
# Class: SamplePreprocessing
#########################################################
# Preprocessing steps applied to samples
before analysis to preserve or prepare them for
measurement.
#########################################################

stbc:SamplePreprocessing a owl:Class ;
  rdfs:comment "Preprocessing steps applied to samples before analysis to preserve or prepare them for measurement." .

stbc:SamplePreprocessing
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty SamplePreprocessing:QuenchingMethod ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplePreprocessing:QuenchingRatio ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplePreprocessing:TreatmentProcedure ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SamplePreprocessing:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: SamplePreprocessing:QuenchingMethod
#########################################################

SamplePreprocessing:QuenchingMethod
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplePreprocessing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SamplePreprocessing/QuenchingMethod" ;
  rdfs:comment "Method used to quench or stop the reaction in the sample." .

#########################################################
# Property: SamplePreprocessing:QuenchingRatio
#########################################################

SamplePreprocessing:QuenchingRatio
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplePreprocessing ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "SamplePreprocessing/QuenchingRatio" ;
  rdfs:comment "Ratio or proportion of quenching agent to sample." .

#########################################################
# Property: SamplePreprocessing:TreatmentProcedure
#########################################################

SamplePreprocessing:TreatmentProcedure
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplePreprocessing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SamplePreprocessing/TreatmentProcedure" ;
  rdfs:comment "Additional treatment procedures applied to the sample." .

#########################################################
# Property: SamplePreprocessing:Notes
#########################################################

SamplePreprocessing:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:SamplePreprocessing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SamplePreprocessing/Notes" ;
  rdfs:comment "Additional notes about sample preprocessing." .

#########################################################
# Class: OperationMode
#########################################################
# Specification of the operational mode and
configuration for conducting biocatalytic
reactions.
#########################################################

stbc:OperationMode a owl:Class ;
  rdfs:comment "Specification of the operational mode and configuration for conducting biocatalytic reactions." .

stbc:OperationMode
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty OperationMode:Mode ;
      owl:onDataRange xsd:OperationModeType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty OperationMode:ReactorType ;
      owl:onDataRange xsd:ReactorType
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty OperationMode:Feeding ;
      owl:allValuesFrom stbc:FeedingStrategy
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty OperationMode:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: OperationMode:Mode
#########################################################

OperationMode:Mode
  a owl:DatatypeProperty;
  rdfs:domain stbc:OperationMode ;
  rdfs:range xsd:OperationModeType ;
  rdfs:label "OperationMode/Mode" ;
  rdfs:comment "The fundamental operation mode defining how the reaction is conducted (batch, fed-batch, continuous, or combinatorial)." .

#########################################################
# Property: OperationMode:ReactorType
#########################################################

OperationMode:ReactorType
  a owl:DatatypeProperty;
  rdfs:domain stbc:OperationMode ;
  rdfs:range xsd:ReactorType ;
  rdfs:label "OperationMode/ReactorType" ;
  rdfs:comment "Type of reactor configuration used (well-mixed, tubular flow, or other)." .

#########################################################
# Property: OperationMode:Feeding
#########################################################

OperationMode:Feeding
  a owl:ObjectProperty;
  rdfs:domain stbc:OperationMode ;
  rdfs:range stbc:FeedingStrategy ;
  rdfs:label "OperationMode/Feeding" ;
  rdfs:comment "Strategy for feeding reactants into the system during the reaction." .

#########################################################
# Property: OperationMode:Notes
#########################################################

OperationMode:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:OperationMode ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "OperationMode/Notes" ;
  rdfs:comment "Additional notes or comments about the operation mode." .

#########################################################
# Class: FeedingStrategy
#########################################################
# Specification of the feeding strategy for
introducing reactants during non-batch operations.
#########################################################

stbc:FeedingStrategy a owl:Class ;
  rdfs:comment "Specification of the feeding strategy for introducing reactants during non-batch operations." .

stbc:FeedingStrategy
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty FeedingStrategy:FeedingType ;
      owl:onDataRange xsd:FeedingType
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FeedingStrategy:Description ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: FeedingStrategy:FeedingType
#########################################################

FeedingStrategy:FeedingType
  a owl:DatatypeProperty;
  rdfs:domain stbc:FeedingStrategy ;
  rdfs:range xsd:FeedingType ;
  rdfs:label "FeedingStrategy/FeedingType" ;
  rdfs:comment "Type of feeding approach used (none, discrete, continuous, or variable)." .

#########################################################
# Property: FeedingStrategy:Description
#########################################################

FeedingStrategy:Description
  a owl:DatatypeProperty;
  rdfs:domain stbc:FeedingStrategy ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FeedingStrategy/Description" ;
  rdfs:comment "Detailed description of the feeding strategy implementation." .

#########################################################
# Class: ReactionComponent
#########################################################
# Comprehensive specification of a single chemical
component used in an enzymatic reaction, including
its identity, role, quantity, source, and storage
requirements.
#########################################################

stbc:ReactionComponent a owl:Class ;
  rdfs:comment "Comprehensive specification of a single chemical component used in an enzymatic reaction, including its identity, role, quantity, source, and storage requirements." .

stbc:ReactionComponent
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Identity ;
      owl:allValuesFrom stbc:ComponentIdentity
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Role ;
      owl:onDataRange xsd:ComponentRole
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Amount ;
      owl:allValuesFrom stbc:AmountConcentration
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Provenance ;
      owl:allValuesFrom stbc:Provenance
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Solubility ;
      owl:allValuesFrom stbc:SolubilityLimit
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Storage ;
      owl:allValuesFrom stbc:StorageConditions
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ReactionComponent:Notes ;
      owl:onDataRange xsd:xsd:string
    ] .

#########################################################
# Property: ReactionComponent:Identity
#########################################################

ReactionComponent:Identity
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range stbc:ComponentIdentity ;
  rdfs:label "ReactionComponent/Identity" ;
  rdfs:comment "Chemical identification and characterization of the component." .

#########################################################
# Property: ReactionComponent:Role
#########################################################

ReactionComponent:Role
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range xsd:ComponentRole ;
  rdfs:label "ReactionComponent/Role" ;
  rdfs:comment "What this component does in the reaction (substrate, cosubstrate, salt, ...)." .

#########################################################
# Property: ReactionComponent:Amount
#########################################################

ReactionComponent:Amount
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range stbc:AmountConcentration ;
  rdfs:label "ReactionComponent/Amount" ;
  rdfs:comment "Quantity or concentration of the component used in the reaction." .

#########################################################
# Property: ReactionComponent:Provenance
#########################################################

ReactionComponent:Provenance
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range stbc:Provenance ;
  rdfs:label "ReactionComponent/Provenance" ;
  rdfs:comment "Source and supplier information for the component." .

#########################################################
# Property: ReactionComponent:Solubility
#########################################################

ReactionComponent:Solubility
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range stbc:SolubilityLimit ;
  rdfs:label "ReactionComponent/Solubility" ;
  rdfs:comment "Solubility characteristics of the component under reaction conditions." .

#########################################################
# Property: ReactionComponent:Storage
#########################################################

ReactionComponent:Storage
  a owl:ObjectProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range stbc:StorageConditions ;
  rdfs:label "ReactionComponent/Storage" ;
  rdfs:comment "Storage requirements and conditions for the component." .

#########################################################
# Property: ReactionComponent:Notes
#########################################################

ReactionComponent:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:ReactionComponent ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ReactionComponent/Notes" ;
  rdfs:comment "Additional notes or comments about the component." .

#########################################################
# Class: ComponentIdentity
#########################################################
# Chemical identification and characterization
information for a component, including names,
structural identifiers, and physical properties.
#########################################################

stbc:ComponentIdentity a owl:Class ;
  rdfs:comment "Chemical identification and characterization information for a component, including names, structural identifiers, and physical properties." .

stbc:ComponentIdentity
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ComponentIdentity:Name ;
      owl:onDataRange xsd:xsd:string
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ComponentIdentity:Smiles ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ComponentIdentity:Identifiers ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty ComponentIdentity:Purity ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ComponentIdentity:Formulation ;
      owl:onDataRange xsd:FormulationType
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: ComponentIdentity:Name
#########################################################

ComponentIdentity:Name
  a owl:DatatypeProperty;
  rdfs:domain stbc:ComponentIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ComponentIdentity/Name" ;
  rdfs:comment "Common or systematic name of the component." .

#########################################################
# Property: ComponentIdentity:Smiles
#########################################################

ComponentIdentity:Smiles
  a owl:DatatypeProperty;
  rdfs:domain stbc:ComponentIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ComponentIdentity/Smiles" ;
  rdfs:comment "SMILES (Simplified Molecular Input Line Entry System) notation for the chemical structure." .

#########################################################
# Property: ComponentIdentity:Identifiers
#########################################################

ComponentIdentity:Identifiers
  a owl:DatatypeProperty;
  rdfs:domain stbc:ComponentIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ComponentIdentity/Identifiers" ;
  rdfs:comment "One or more identifiers like CAS, PubChem CID, InChI, etc." .

#########################################################
# Property: ComponentIdentity:Purity
#########################################################

ComponentIdentity:Purity
  a owl:DatatypeProperty;
  rdfs:domain stbc:ComponentIdentity ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "ComponentIdentity/Purity" ;
  rdfs:comment "Purity of the component as a percentage or fraction." .

#########################################################
# Property: ComponentIdentity:Formulation
#########################################################

ComponentIdentity:Formulation
  a owl:DatatypeProperty;
  rdfs:domain stbc:ComponentIdentity ;
  rdfs:range xsd:FormulationType ;
  rdfs:label "ComponentIdentity/Formulation" ;
  rdfs:comment "Physical form or formulation of the component (powder, liquid, solution, etc.)." .

#########################################################
# Class: AmountConcentration
#########################################################
# Quantitative specification of component amount
or concentration used in the reaction.
#########################################################

stbc:AmountConcentration a owl:Class ;
  rdfs:comment "Quantitative specification of component amount or concentration used in the reaction." .

stbc:AmountConcentration
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty AmountConcentration:Value ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty AmountConcentration:Unit ;
      owl:allValuesFrom stbc:UnitDefinition
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: AmountConcentration:Value
#########################################################

AmountConcentration:Value
  a owl:DatatypeProperty;
  rdfs:domain stbc:AmountConcentration ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "AmountConcentration/Value" ;
  rdfs:comment "Numerical value of the amount or concentration." .

#########################################################
# Property: AmountConcentration:Unit
#########################################################

AmountConcentration:Unit
  a owl:ObjectProperty;
  rdfs:domain stbc:AmountConcentration ;
  rdfs:range stbc:UnitDefinition ;
  rdfs:label "AmountConcentration/Unit" ;
  rdfs:comment "Unit of measurement for the amount or concentration." .

#########################################################
# Class: Provenance
#########################################################
# Source and supplier information for component
traceability and reproducibility.
#########################################################

stbc:Provenance a owl:Class ;
  rdfs:comment "Source and supplier information for component traceability and reproducibility." .

stbc:Provenance
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Provenance:Supplier ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: Provenance:Supplier
#########################################################

Provenance:Supplier
  a owl:DatatypeProperty;
  rdfs:domain stbc:Provenance ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Provenance/Supplier" ;
  rdfs:comment "Supplier/manufacturer or \"prepared in lab\"; include product code or citation if applicable." .

#########################################################
# Class: SolubilityLimit
#########################################################
# Solubility characteristics of the component
under specific conditions.
#########################################################

stbc:SolubilityLimit a owl:Class ;
  rdfs:comment "Solubility characteristics of the component under specific conditions." .

stbc:SolubilityLimit
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty SolubilityLimit:Value ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty SolubilityLimit:Unit ;
      owl:allValuesFrom stbc:UnitDefinition
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: SolubilityLimit:Value
#########################################################

SolubilityLimit:Value
  a owl:DatatypeProperty;
  rdfs:domain stbc:SolubilityLimit ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "SolubilityLimit/Value" ;
  rdfs:comment "Numerical value of the solubility limit." .

#########################################################
# Property: SolubilityLimit:Unit
#########################################################

SolubilityLimit:Unit
  a owl:ObjectProperty;
  rdfs:domain stbc:SolubilityLimit ;
  rdfs:range stbc:UnitDefinition ;
  rdfs:label "SolubilityLimit/Unit" ;
  rdfs:comment "Unit of measurement for the solubility limit." .