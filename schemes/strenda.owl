      owl:onProperty MechanicalMixing:StirrerSpeed ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MechanicalMixing:HeightAboveBase ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MechanicalMixing:PowerPerVolume ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MechanicalMixing:StirBar ;
      owl:allValuesFrom stbc:StirBar
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty MechanicalMixing:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: MechanicalMixing:StirringType
#########################################################

MechanicalMixing:StirringType
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MechanicalMixing/StirringType" ;
  rdfs:comment "Type of mechanical stirring (e.g., overhead, magnetic, impeller)." .

#########################################################
# Property: MechanicalMixing:StirrerMaterial
#########################################################

MechanicalMixing:StirrerMaterial
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MechanicalMixing/StirrerMaterial" ;
  rdfs:comment "Material composition of the stirrer or impeller." .

#########################################################
# Property: MechanicalMixing:Supplier
#########################################################

MechanicalMixing:Supplier
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MechanicalMixing/Supplier" ;
  rdfs:comment "Manufacturer or supplier of the stirring equipment." .

#########################################################
# Property: MechanicalMixing:NumberOfStirrers
#########################################################

MechanicalMixing:NumberOfStirrers
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:integer ;
  rdfs:label "MechanicalMixing/NumberOfStirrers" ;
  rdfs:comment "Number of stirrers or impellers used in the system." .

#########################################################
# Property: MechanicalMixing:StirrerGeometry
#########################################################

MechanicalMixing:StirrerGeometry
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MechanicalMixing/StirrerGeometry" ;
  rdfs:comment "Geometric design and shape of the stirrer or impeller." .

#########################################################
# Property: MechanicalMixing:BladePitchAngle
#########################################################

MechanicalMixing:BladePitchAngle
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "MechanicalMixing/BladePitchAngle" ;
  rdfs:comment "Angle of the stirrer blades relative to the horizontal plane." .

#########################################################
# Property: MechanicalMixing:BladeSize
#########################################################

MechanicalMixing:BladeSize
  a owl:ObjectProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range stbc:Quantity ;
  rdfs:label "MechanicalMixing/BladeSize" ;
  rdfs:comment "Dimensions or size of the stirrer blades." .

#########################################################
# Property: MechanicalMixing:StirrerSpeed
#########################################################

MechanicalMixing:StirrerSpeed
  a owl:ObjectProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range stbc:Quantity ;
  rdfs:label "MechanicalMixing/StirrerSpeed" ;
  rdfs:comment "Rotational speed of the stirrer or impeller." .

#########################################################
# Property: MechanicalMixing:HeightAboveBase
#########################################################

MechanicalMixing:HeightAboveBase
  a owl:ObjectProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range stbc:Quantity ;
  rdfs:label "MechanicalMixing/HeightAboveBase" ;
  rdfs:comment "Distance of the stirrer from the bottom of the vessel." .

#########################################################
# Property: MechanicalMixing:PowerPerVolume
#########################################################

MechanicalMixing:PowerPerVolume
  a owl:ObjectProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range stbc:Quantity ;
  rdfs:label "MechanicalMixing/PowerPerVolume" ;
  rdfs:comment "Power input per unit volume of the reaction mixture." .

#########################################################
# Property: MechanicalMixing:StirBar
#########################################################

MechanicalMixing:StirBar
  a owl:ObjectProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range stbc:StirBar ;
  rdfs:label "MechanicalMixing/StirBar" ;
  rdfs:comment "Magnetic stir bar specifications for magnetic stirring systems." .

#########################################################
# Property: MechanicalMixing:Notes
#########################################################

MechanicalMixing:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:MechanicalMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "MechanicalMixing/Notes" ;
  rdfs:comment "Additional notes about the mechanical mixing setup." .

#########################################################
# Class: StirBar
#########################################################
# Magnetic stir bar specifications for magnetic
stirring systems.
#########################################################

stbc:StirBar a owl:Class ;
  rdfs:comment "Magnetic stir bar specifications for magnetic stirring systems." .

stbc:StirBar
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty StirBar:Size ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty StirBar:Shape ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: StirBar:Size
#########################################################

StirBar:Size
  a owl:ObjectProperty;
  rdfs:domain stbc:StirBar ;
  rdfs:range stbc:Quantity ;
  rdfs:label "StirBar/Size" ;
  rdfs:comment "Length and diameter of the magnetic stir bar." .

#########################################################
# Property: StirBar:Shape
#########################################################

StirBar:Shape
  a owl:DatatypeProperty;
  rdfs:domain stbc:StirBar ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "StirBar/Shape" ;
  rdfs:comment "Shape of the stir bar (e.g., cylindrical, octagonal, cross-shaped)." .

#########################################################
# Class: FluidImpelledMixing
#########################################################
# Parameters for fluid-driven mixing in flow-based
reactor systems.
#########################################################

stbc:FluidImpelledMixing a owl:Class ;
  rdfs:comment "Parameters for fluid-driven mixing in flow-based reactor systems." .

stbc:FluidImpelledMixing
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:PhaseVolumeDescription ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:ResidenceTime ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:ReynoldsNumber ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:PassiveMixing ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:ActiveMixer ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:Pulsing ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty FluidImpelledMixing:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: FluidImpelledMixing:PhaseVolumeDescription
#########################################################

FluidImpelledMixing:PhaseVolumeDescription
  a owl:DatatypeProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FluidImpelledMixing/PhaseVolumeDescription" ;
  rdfs:comment "Description of phase volumes and their distribution in the flow system." .

#########################################################
# Property: FluidImpelledMixing:ResidenceTime
#########################################################

FluidImpelledMixing:ResidenceTime
  a owl:ObjectProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range stbc:Quantity ;
  rdfs:label "FluidImpelledMixing/ResidenceTime" ;
  rdfs:comment "Average residence time of the fluid in the mixing zone." .

#########################################################
# Property: FluidImpelledMixing:ReynoldsNumber
#########################################################

FluidImpelledMixing:ReynoldsNumber
  a owl:DatatypeProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FluidImpelledMixing/ReynoldsNumber" ;
  rdfs:comment "Reynolds number characterizing the flow regime and mixing intensity." .

#########################################################
# Property: FluidImpelledMixing:PassiveMixing
#########################################################

FluidImpelledMixing:PassiveMixing
  a owl:DatatypeProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FluidImpelledMixing/PassiveMixing" ;
  rdfs:comment "Description of passive mixing elements or structures used." .

#########################################################
# Property: FluidImpelledMixing:ActiveMixer
#########################################################

FluidImpelledMixing:ActiveMixer
  a owl:DatatypeProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FluidImpelledMixing/ActiveMixer" ;
  rdfs:comment "Description of active mixing devices or mechanisms employed." .

#########################################################
# Property: FluidImpelledMixing:Pulsing
#########################################################

FluidImpelledMixing:Pulsing
  a owl:DatatypeProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FluidImpelledMixing/Pulsing" ;
  rdfs:comment "Pulsing or oscillatory flow patterns used to enhance mixing." .

#########################################################
# Property: FluidImpelledMixing:Notes
#########################################################

FluidImpelledMixing:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:FluidImpelledMixing ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "FluidImpelledMixing/Notes" ;
  rdfs:comment "Additional notes about the fluid-impelled mixing system." .

#########################################################
# Class: Biocatalyst
#########################################################
# A biocatalyst is an enzyme or enzyme-containing
system used to catalyze biochemical reactions.
This section defines the complete characterization
of a biocatalyst including its identity, source,
application conditions, immobilization status, and
storage requirements.
#########################################################

stbc:Biocatalyst a owl:Class ;
  rdfs:comment "A biocatalyst is an enzyme or enzyme-containing system used to catalyze biochemical reactions. This section defines the complete characterization of a biocatalyst including its identity, source, application conditions, immobilization status, and storage requirements." .

stbc:Biocatalyst
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Biocatalyst:Identity ;
      owl:allValuesFrom stbc:BiocatalystIdentity
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Biocatalyst:Source ;
      owl:allValuesFrom stbc:BiocatalystSource
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Biocatalyst:Application ;
      owl:allValuesFrom stbc:BiocatalystApplication
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Biocatalyst:Immobilization ;
      owl:allValuesFrom stbc:Immobilization
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Biocatalyst:Storage ;
      owl:allValuesFrom stbc:StorageConditions
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Biocatalyst:Notes ;
      owl:onDataRange xsd:xsd:string
    ] .

#########################################################
# Property: Biocatalyst:Identity
#########################################################

Biocatalyst:Identity
  a owl:ObjectProperty;
  rdfs:domain stbc:Biocatalyst ;
  rdfs:range stbc:BiocatalystIdentity ;
  rdfs:label "Biocatalyst/Identity" ;
  rdfs:comment "Essential identifying information about the biocatalyst including name, EC number, molecular properties, and sequence data." .

#########################################################
# Property: Biocatalyst:Source
#########################################################

Biocatalyst:Source
  a owl:ObjectProperty;
  rdfs:domain stbc:Biocatalyst ;
  rdfs:range stbc:BiocatalystSource ;
  rdfs:label "Biocatalyst/Source" ;
  rdfs:comment "Information about how the biocatalyst was obtained, whether purchased commercially or produced in-house." .

#########################################################
# Property: Biocatalyst:Application
#########################################################

Biocatalyst:Application
  a owl:ObjectProperty;
  rdfs:domain stbc:Biocatalyst ;
  rdfs:range stbc:BiocatalystApplication ;
  rdfs:label "Biocatalyst/Application" ;
  rdfs:comment "Details about how the biocatalyst is applied in the reaction, including concentration, activity, and workflow specifics." .

#########################################################
# Property: Biocatalyst:Immobilization
#########################################################

Biocatalyst:Immobilization
  a owl:ObjectProperty;
  rdfs:domain stbc:Biocatalyst ;
  rdfs:range stbc:Immobilization ;
  rdfs:label "Biocatalyst/Immobilization" ;
  rdfs:comment "Information about whether and how the biocatalyst is immobilized on a support material." .

#########################################################
# Property: Biocatalyst:Storage
#########################################################

Biocatalyst:Storage
  a owl:ObjectProperty;
  rdfs:domain stbc:Biocatalyst ;
  rdfs:range stbc:StorageConditions ;
  rdfs:label "Biocatalyst/Storage" ;
  rdfs:comment "Conditions under which the biocatalyst is stored to maintain its activity and stability." .

#########################################################
# Property: Biocatalyst:Notes
#########################################################

Biocatalyst:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:Biocatalyst ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Biocatalyst/Notes" ;
  rdfs:comment "Additional notes or comments about the biocatalyst that don't fit in other categories." .

#########################################################
# Class: BiocatalystIdentity
#########################################################
# Core identifying information and molecular
characteristics of the biocatalyst enzyme.
#########################################################

stbc:BiocatalystIdentity a owl:Class ;
  rdfs:comment "Core identifying information and molecular characteristics of the biocatalyst enzyme." .

stbc:BiocatalystIdentity
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:Name ;
      owl:onDataRange xsd:xsd:string
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:EcNumber ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:MolecularWeight ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:MolecularWeightUnit ;
      owl:onDataRange xsd:MolecularWeightUnit
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:CatalyzedReaction ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:Sequences ;
      owl:allValuesFrom stbc:SequenceInfo
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:OriginOrganism ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:ProductionOrganism ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystIdentity:PosttranslationalModification ;
      owl:onDataRange xsd:xsd:string
    ] .

#########################################################
# Property: BiocatalystIdentity:Name
#########################################################

BiocatalystIdentity:Name
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystIdentity/Name" ;
  rdfs:comment "The name of the biocatalyst, which can be the trivial name, systematic name, or trade name." .

#########################################################
# Property: BiocatalystIdentity:EcNumber
#########################################################

BiocatalystIdentity:EcNumber
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystIdentity/EcNumber" ;
  rdfs:comment "The Enzyme Commission (EC) number that classifies the enzyme according to the reaction it catalyzes." .

#########################################################
# Property: BiocatalystIdentity:MolecularWeight
#########################################################

BiocatalystIdentity:MolecularWeight
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "BiocatalystIdentity/MolecularWeight" ;
  rdfs:comment "The molecular weight of the enzyme in the specified units." .

#########################################################
# Property: BiocatalystIdentity:MolecularWeightUnit
#########################################################

BiocatalystIdentity:MolecularWeightUnit
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:MolecularWeightUnit ;
  rdfs:label "BiocatalystIdentity/MolecularWeightUnit" ;
  rdfs:comment "The unit of measurement for the molecular weight (e.g., kDa, Da)." .

#########################################################
# Property: BiocatalystIdentity:CatalyzedReaction
#########################################################

BiocatalystIdentity:CatalyzedReaction
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystIdentity/CatalyzedReaction" ;
  rdfs:comment "Description of the specific reaction or type of reaction catalyzed by this enzyme." .

#########################################################
# Property: BiocatalystIdentity:Sequences
#########################################################

BiocatalystIdentity:Sequences
  a owl:ObjectProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range stbc:SequenceInfo ;
  rdfs:label "BiocatalystIdentity/Sequences" ;
  rdfs:comment "Amino acid and/or DNA sequence information for the enzyme." .

#########################################################
# Property: BiocatalystIdentity:OriginOrganism
#########################################################

BiocatalystIdentity:OriginOrganism
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystIdentity/OriginOrganism" ;
  rdfs:comment "The organism from which the enzyme was originally derived or isolated." .

#########################################################
# Property: BiocatalystIdentity:ProductionOrganism
#########################################################

BiocatalystIdentity:ProductionOrganism
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystIdentity/ProductionOrganism" ;
  rdfs:comment "The organism used to produce the enzyme (may differ from origin organism for recombinant enzymes)." .

#########################################################
# Property: BiocatalystIdentity:PosttranslationalModification
#########################################################

BiocatalystIdentity:PosttranslationalModification
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystIdentity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystIdentity/PosttranslationalModification" ;
  rdfs:comment "Any post-translational modifications present on the enzyme that may affect its activity or properties." .

#########################################################
# Class: SequenceInfo
#########################################################
# Sequence information for the biocatalyst at both
the protein and nucleic acid levels.
#########################################################

stbc:SequenceInfo a owl:Class ;
  rdfs:comment "Sequence information for the biocatalyst at both the protein and nucleic acid levels." .

stbc:SequenceInfo
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty SequenceInfo:SequenceAminoAcid ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty SequenceInfo:SequenceDna ;
      owl:onDataRange xsd:xsd:string
    ] .

#########################################################
# Property: SequenceInfo:SequenceAminoAcid
#########################################################

SequenceInfo:SequenceAminoAcid
  a owl:DatatypeProperty;
  rdfs:domain stbc:SequenceInfo ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SequenceInfo/SequenceAminoAcid" ;
  rdfs:comment "The amino acid sequence of the enzyme in single-letter code format." .

#########################################################
# Property: SequenceInfo:SequenceDna
#########################################################

SequenceInfo:SequenceDna
  a owl:DatatypeProperty;
  rdfs:domain stbc:SequenceInfo ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SequenceInfo/SequenceDna" ;
  rdfs:comment "The DNA sequence encoding the enzyme." .

#########################################################
# Class: BiocatalystSource
#########################################################
# Information about the source and procurement of
the biocatalyst.
#########################################################

stbc:BiocatalystSource a owl:Class ;
  rdfs:comment "Information about the source and procurement of the biocatalyst." .

stbc:BiocatalystSource
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystSource:SourceType ;
      owl:onDataRange xsd:BiocatalystSourceType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystSource:Supplier ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystSource:PurchasedDetails ;
      owl:allValuesFrom stbc:PurchasedDetails
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystSource:SelfProducedDetails ;
      owl:allValuesFrom stbc:SelfProducedDetails
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: BiocatalystSource:SourceType
#########################################################

BiocatalystSource:SourceType
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystSource ;
  rdfs:range xsd:BiocatalystSourceType ;
  rdfs:label "BiocatalystSource/SourceType" ;
  rdfs:comment "Whether the biocatalyst was purchased from a supplier or produced in-house." .

#########################################################
# Property: BiocatalystSource:Supplier
#########################################################

BiocatalystSource:Supplier
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystSource ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "BiocatalystSource/Supplier" ;
  rdfs:comment "Name of the commercial supplier or source of the biocatalyst." .

#########################################################
# Property: BiocatalystSource:PurchasedDetails
#########################################################

BiocatalystSource:PurchasedDetails
  a owl:ObjectProperty;
  rdfs:domain stbc:BiocatalystSource ;
  rdfs:range stbc:PurchasedDetails ;
  rdfs:label "BiocatalystSource/PurchasedDetails" ;
  rdfs:comment "Specific details relevant to commercially purchased biocatalysts." .

#########################################################
# Property: BiocatalystSource:SelfProducedDetails
#########################################################

BiocatalystSource:SelfProducedDetails
  a owl:ObjectProperty;
  rdfs:domain stbc:BiocatalystSource ;
  rdfs:range stbc:SelfProducedDetails ;
  rdfs:label "BiocatalystSource/SelfProducedDetails" ;
  rdfs:comment "Specific details relevant to biocatalysts produced in-house." .

#########################################################
# Class: PurchasedDetails
#########################################################
# Detailed information for commercially purchased
biocatalysts.
#########################################################

stbc:PurchasedDetails a owl:Class ;
  rdfs:comment "Detailed information for commercially purchased biocatalysts." .

stbc:PurchasedDetails
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty PurchasedDetails:Reference ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty PurchasedDetails:Purity ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty PurchasedDetails:PuritySpecification ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
