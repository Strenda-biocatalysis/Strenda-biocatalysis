stbc:ThermodynamicResults a owl:Class ;
  rdfs:comment "Thermodynamic parameters characterizing the energetics of the enzymatic reaction." .

stbc:ThermodynamicResults
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ThermodynamicResults:GibbsFreeEnergyChange ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ThermodynamicResults:EnthalpyChange ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ThermodynamicResults:EntropyChange ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ThermodynamicResults:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
