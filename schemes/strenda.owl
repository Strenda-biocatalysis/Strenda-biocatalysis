      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty ApplicationWorkflowDetails:SourceOfCellfreeExtract ;
      owl:onDataRange xsd:xsd:string
    ] .

