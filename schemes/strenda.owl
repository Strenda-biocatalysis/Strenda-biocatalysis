#########################################################
# Class: Concentration
#########################################################
# Quantitative information about biocatalyst
concentration in the reaction.
#########################################################

stbc:Concentration a owl:Class ;
  rdfs:comment "Quantitative information about biocatalyst concentration in the reaction." .

stbc:Concentration
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Concentration:Value ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Concentration:Unit ;
      owl:allValuesFrom stbc:UnitDefinition
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Concentration:DeterminationMethod ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: Concentration:Value
#########################################################

Concentration:Value
  a owl:DatatypeProperty;
  rdfs:domain stbc:Concentration ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "Concentration/Value" ;
  rdfs:comment "Numerical value of the concentration." .

#########################################################
# Property: Concentration:Unit
#########################################################

Concentration:Unit
  a owl:ObjectProperty;
  rdfs:domain stbc:Concentration ;
  rdfs:range stbc:UnitDefinition ;
  rdfs:label "Concentration/Unit" ;
  rdfs:comment "Unit of measurement for the concentration (e.g., mg/mL, µM, U/mL)." .

#########################################################
# Property: Concentration:DeterminationMethod
#########################################################

Concentration:DeterminationMethod
  a owl:DatatypeProperty;
  rdfs:domain stbc:Concentration ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Concentration/DeterminationMethod" ;
  rdfs:comment "Method used to determine or calculate the concentration." .

#########################################################
# Class: Activity
#########################################################
# Enzymatic activity measurement of the
biocatalyst.
#########################################################

stbc:Activity a owl:Class ;
  rdfs:comment "Enzymatic activity measurement of the biocatalyst." .

stbc:Activity
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Activity:Value ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Activity:Unit ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Activity:DeterminationMethod ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: Activity:Value
#########################################################

Activity:Value
  a owl:DatatypeProperty;
  rdfs:domain stbc:Activity ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "Activity/Value" ;
  rdfs:comment "Numerical value of the measured activity." .

#########################################################
# Property: Activity:Unit
#########################################################

Activity:Unit
  a owl:DatatypeProperty;
  rdfs:domain stbc:Activity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Activity/Unit" ;
  rdfs:comment "Unit of measurement for the activity (e.g., U/mg, µmol/min/mg)." .

#########################################################
# Property: Activity:DeterminationMethod
#########################################################

Activity:DeterminationMethod
  a owl:DatatypeProperty;
  rdfs:domain stbc:Activity ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Activity/DeterminationMethod" ;
  rdfs:comment "Assay method used to measure the enzymatic activity." .

#########################################################
# Class: ApplicationWorkflowDetails
#########################################################
# Specific workflow steps and procedures used when
applying the biocatalyst.
