SelectivityResults:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SelectivityResults/Notes" ;
  rdfs:comment "Additional notes about selectivity measurements." .

#########################################################
