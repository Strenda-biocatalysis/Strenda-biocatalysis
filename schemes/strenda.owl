BiocatalystApplication:WorkflowDetails
  a owl:ObjectProperty;
  rdfs:domain stbc:BiocatalystApplication ;
  rdfs:range stbc:ApplicationWorkflowDetails ;
  rdfs:label "BiocatalystApplication/WorkflowDetails" ;
