SelectivityResults:Enantioselectivity
  a owl:DatatypeProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range xsd:xsd:decimal ;
  rdfs:label "SelectivityResults/Enantioselectivity" ;
  rdfs:comment "Enantioselectivity ratio (E-value) indicating preference for one enantiomer over another." .

#########################################################
# Property: SelectivityResults:EnantiomericExcess
#########################################################

SelectivityResults:EnantiomericExcess
  a owl:ObjectProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range stbc:Quantity ;
  rdfs:label "SelectivityResults/EnantiomericExcess" ;
  rdfs:comment "Enantiomeric excess (ee) as percentage indicating optical purity of the product." .

#########################################################
# Property: SelectivityResults:DiastereomericExcess
#########################################################

SelectivityResults:DiastereomericExcess
  a owl:ObjectProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range stbc:Quantity ;
  rdfs:label "SelectivityResults/DiastereomericExcess" ;
  rdfs:comment "Diastereomeric excess (de) as percentage for reactions producing diastereomers." .

#########################################################
# Property: SelectivityResults:IsomericContent
#########################################################

SelectivityResults:IsomericContent
  a owl:ObjectProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range stbc:Quantity ;
  rdfs:label "SelectivityResults/IsomericContent" ;
  rdfs:comment "Content or ratio of specific isomers in the product mixture." .

#########################################################
# Property: SelectivityResults:Chemoselectivity
#########################################################

SelectivityResults:Chemoselectivity
  a owl:DatatypeProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SelectivityResults/Chemoselectivity" ;
  rdfs:comment "Description of chemoselectivity when multiple reaction pathways are possible." .

#########################################################
# Property: SelectivityResults:Regioselectivity
#########################################################

SelectivityResults:Regioselectivity
  a owl:DatatypeProperty;
  rdfs:domain stbc:SelectivityResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "SelectivityResults/Regioselectivity" ;
  rdfs:comment "Description of regioselectivity indicating preference for specific reaction sites." .

#########################################################
