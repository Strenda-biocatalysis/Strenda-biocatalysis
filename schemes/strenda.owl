  rdfs:domain stbc:KineticResults ;
  rdfs:range stbc:Quantity ;
  rdfs:label "KineticResults/TurnoverNumber" ;
  rdfs:comment "Turnover number (kcat) representing the maximum number of substrate molecules converted per enzyme molecule per unit time." .

