#########################################################
# Class: BiocatalystApplication
#########################################################
# Details about how the biocatalyst is applied and
used in the reaction system.
#########################################################

stbc:BiocatalystApplication a owl:Class ;
  rdfs:comment "Details about how the biocatalyst is applied and used in the reaction system." .

stbc:BiocatalystApplication
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystApplication:ApplicationType ;
      owl:onDataRange xsd:BiocatalystApplicationType
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystApplication:Concentration ;
      owl:allValuesFrom stbc:Concentration
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystApplication:Activity ;
      owl:allValuesFrom stbc:Activity
    ],
    [
      a owl:Restriction ;
      owl:onProperty BiocatalystApplication:WorkflowDetails ;
      owl:allValuesFrom stbc:ApplicationWorkflowDetails
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: BiocatalystApplication:ApplicationType
#########################################################

BiocatalystApplication:ApplicationType
  a owl:DatatypeProperty;
  rdfs:domain stbc:BiocatalystApplication ;
  rdfs:range xsd:BiocatalystApplicationType ;
  rdfs:label "BiocatalystApplication/ApplicationType" ;
  rdfs:comment "The form in which the biocatalyst is applied (purified enzyme, crude extract, whole cells, etc.)." .

#########################################################
# Property: BiocatalystApplication:Concentration
#########################################################

BiocatalystApplication:Concentration
  a owl:ObjectProperty;
  rdfs:domain stbc:BiocatalystApplication ;
