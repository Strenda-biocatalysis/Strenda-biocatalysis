#########################################################

ApplicationWorkflowDetails:SourceOfCellfreeExtract
  a owl:DatatypeProperty;
  rdfs:domain stbc:ApplicationWorkflowDetails ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ApplicationWorkflowDetails/SourceOfCellfreeExtract" ;
  rdfs:comment "Details about the source and preparation of cell-free extracts if applicable." .

#########################################################
# Class: Immobilization
#########################################################
# Information about biocatalyst immobilization on
solid supports.
#########################################################

stbc:Immobilization a owl:Class ;
  rdfs:comment "Information about biocatalyst immobilization on solid supports." .

stbc:Immobilization
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:Immobilized ;
      owl:onDataRange xsd:xsd:boolean
      ; owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:BiocatalystState ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:ImmobilisationChemistry ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:CarrierMaterial ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:Linkers ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:ImmobilisationMethod ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:PurificationMethod ;
      owl:onDataRange xsd:xsd:string
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:Loading ;
      owl:allValuesFrom stbc:Concentration
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty Immobilization:Notes ;
      owl:onDataRange xsd:xsd:string
    ] .

#########################################################
# Property: Immobilization:Immobilized
#########################################################

Immobilization:Immobilized
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:boolean ;
  rdfs:label "Immobilization/Immobilized" ;
  rdfs:comment "Whether the biocatalyst is immobilized (true) or used in free form (false)." .

#########################################################
# Property: Immobilization:BiocatalystState
#########################################################

Immobilization:BiocatalystState
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/BiocatalystState" ;
  rdfs:comment "Physical state of the biocatalyst during immobilization (e.g., purified enzyme, crude extract)." .

#########################################################
# Property: Immobilization:ImmobilisationChemistry
#########################################################

Immobilization:ImmobilisationChemistry
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/ImmobilisationChemistry" ;
  rdfs:comment "Chemical method or mechanism used for immobilization (e.g., covalent binding, adsorption, entrapment)." .

#########################################################
# Property: Immobilization:CarrierMaterial
#########################################################

Immobilization:CarrierMaterial
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/CarrierMaterial" ;
  rdfs:comment "Material used as the solid support for immobilization." .

#########################################################
# Property: Immobilization:Linkers
#########################################################

Immobilization:Linkers
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/Linkers" ;
  rdfs:comment "Chemical linkers or spacers used between the enzyme and carrier material." .

#########################################################
# Property: Immobilization:ImmobilisationMethod
#########################################################

Immobilization:ImmobilisationMethod
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/ImmobilisationMethod" ;
  rdfs:comment "Detailed procedure used for the immobilization process." .

#########################################################
# Property: Immobilization:PurificationMethod
#########################################################

Immobilization:PurificationMethod
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/PurificationMethod" ;
  rdfs:comment "Method used to purify or wash the immobilized biocatalyst." .

#########################################################
# Property: Immobilization:Loading
#########################################################

Immobilization:Loading
  a owl:ObjectProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range stbc:Concentration ;
  rdfs:label "Immobilization/Loading" ;
  rdfs:comment "Amount of enzyme loaded onto the carrier material." .

#########################################################
# Property: Immobilization:Notes
#########################################################

Immobilization:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:Immobilization ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "Immobilization/Notes" ;
  rdfs:comment "Additional notes about the immobilization process or properties." .

#########################################################
# Class: ExperimentalResults
#########################################################
# Comprehensive collection of experimental results
from enzymatic reactions.
#########################################################

stbc:ExperimentalResults a owl:Class ;
  rdfs:comment "Comprehensive collection of experimental results from enzymatic reactions." .

stbc:ExperimentalResults
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty ExperimentalResults:Kinetics ;
      owl:allValuesFrom stbc:KineticResults
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ExperimentalResults:YieldAndConversion ;
      owl:allValuesFrom stbc:YieldAndConversionResults
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ExperimentalResults:Activity ;
      owl:allValuesFrom stbc:ActivityResults
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ExperimentalResults:Selectivity ;
      owl:allValuesFrom stbc:SelectivityResults
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ExperimentalResults:Thermodynamics ;
      owl:allValuesFrom stbc:ThermodynamicResults
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty ExperimentalResults:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: ExperimentalResults:Kinetics
#########################################################

ExperimentalResults:Kinetics
  a owl:ObjectProperty;
  rdfs:domain stbc:ExperimentalResults ;
  rdfs:range stbc:KineticResults ;
  rdfs:label "ExperimentalResults/Kinetics" ;
  rdfs:comment "Kinetic parameters and enzyme behavior characteristics." .

#########################################################
# Property: ExperimentalResults:YieldAndConversion
#########################################################

ExperimentalResults:YieldAndConversion
  a owl:ObjectProperty;
  rdfs:domain stbc:ExperimentalResults ;
  rdfs:range stbc:YieldAndConversionResults ;
  rdfs:label "ExperimentalResults/YieldAndConversion" ;
  rdfs:comment "Product yield and substrate conversion measurements." .

#########################################################
# Property: ExperimentalResults:Activity
#########################################################

ExperimentalResults:Activity
  a owl:ObjectProperty;
  rdfs:domain stbc:ExperimentalResults ;
  rdfs:range stbc:ActivityResults ;
  rdfs:label "ExperimentalResults/Activity" ;
  rdfs:comment "Enzyme activity and initial reaction rate data." .

#########################################################
# Property: ExperimentalResults:Selectivity
#########################################################

ExperimentalResults:Selectivity
  a owl:ObjectProperty;
  rdfs:domain stbc:ExperimentalResults ;
  rdfs:range stbc:SelectivityResults ;
  rdfs:label "ExperimentalResults/Selectivity" ;
  rdfs:comment "Selectivity measurements including stereoselectivity and enantioselectivity." .

#########################################################
# Property: ExperimentalResults:Thermodynamics
#########################################################

ExperimentalResults:Thermodynamics
  a owl:ObjectProperty;
  rdfs:domain stbc:ExperimentalResults ;
  rdfs:range stbc:ThermodynamicResults ;
  rdfs:label "ExperimentalResults/Thermodynamics" ;
  rdfs:comment "Thermodynamic parameters of the reaction." .

#########################################################
# Property: ExperimentalResults:Notes
#########################################################

ExperimentalResults:Notes
  a owl:DatatypeProperty;
  rdfs:domain stbc:ExperimentalResults ;
  rdfs:range xsd:xsd:string ;
  rdfs:label "ExperimentalResults/Notes" ;
  rdfs:comment "Additional notes or comments about the experimental results." .

#########################################################
# Class: KineticResults
#########################################################
# Kinetic parameters characterizing enzyme
behavior and reaction mechanisms.
#########################################################

stbc:KineticResults a owl:Class ;
  rdfs:comment "Kinetic parameters characterizing enzyme behavior and reaction mechanisms." .

stbc:KineticResults
  rdfs:subClassOf
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:MichaelisConstant ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:MaximumReactionRate ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:TurnoverNumber ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:CatalyticEfficiency ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:DissociationConstant ;
      owl:allValuesFrom stbc:Quantity
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:Inhibition ;
      owl:allValuesFrom stbc:InhibitionParameters
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:HillCoefficient ;
      owl:onDataRange xsd:xsd:decimal
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:EnzymeStability ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ],
    [
      a owl:Restriction ;
      owl:onProperty KineticResults:Notes ;
      owl:onDataRange xsd:xsd:string
      ; owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger
    ] .

#########################################################
# Property: KineticResults:MichaelisConstant
#########################################################

KineticResults:MichaelisConstant
  a owl:ObjectProperty;
  rdfs:domain stbc:KineticResults ;
  rdfs:range stbc:Quantity ;
  rdfs:label "KineticResults/MichaelisConstant" ;
  rdfs:comment "Michaelis constant (Km) representing the substrate concentration at half-maximum reaction rate." .

#########################################################
# Property: KineticResults:MaximumReactionRate
#########################################################

KineticResults:MaximumReactionRate
  a owl:ObjectProperty;
  rdfs:domain stbc:KineticResults ;
  rdfs:range stbc:Quantity ;
  rdfs:label "KineticResults/MaximumReactionRate" ;
  rdfs:comment "Maximum reaction rate (Vmax) achieved under saturating substrate conditions." .

#########################################################
