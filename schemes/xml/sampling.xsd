<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Roots -->
    <xs:element name="Sampling" type="SamplingType"/>
    <xs:element name="SamplingStrategy" type="SamplingStrategyType"/>
    <xs:element name="Sample" type="SampleType"/>
    <xs:element name="SamplePreprocessing" type="SamplePreprocessingType"/>
    <xs:element name="Quantity" type="QuantityType"/>
    <xs:element name="StorageConditions" type="StorageConditionsType"/>

    <!-- Sampling Definition -->
    <xs:complexType name="SamplingType">
        <xs:sequence>
            <xs:element name="sampling_applied" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Indicates whether physical sampling was performed at all.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="strategy" type="SamplingStrategyType">
                <xs:annotation>
                    <xs:documentation>
                        Details about the sampling strategy and methodology used.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="samples">
                <xs:annotation>
                    <xs:documentation>
                        Collection of individual samples taken during the reaction.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Sample" type="SampleType" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes or comments about the sampling procedure.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SamplingStrategy Definition -->
    <xs:complexType name="SamplingStrategyType">
        <xs:sequence>
            <xs:element name="strategy_type" type="SamplingStrategyTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Type of sampling strategy employed (default or specialized).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="mixing_during_sampling" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of mixing conditions maintained during sample collection.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="vessel_opened" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Indicates whether the reaction vessel was opened during sampling.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="gas_phase" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of gas phase conditions or handling during sampling.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the sampling strategy.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Sample Definition -->
    <xs:complexType name="SampleType">
        <xs:sequence>
            <xs:element name="time" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Time point at which the sample was collected.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="time_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the sampling time.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amount" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Amount or volume of sample collected.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amount_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the amount.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="phase" type="PhaseTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Phase from which the sample was collected (liquid, solid, gas, etc.).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="biocatalyst_in_sample" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of biocatalyst presence or handling in the sample.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="preprocessing" type="SamplePreprocessingType">
                <xs:annotation>
                    <xs:documentation>
                        Any preprocessing steps applied to the sample before analysis.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the individual sample.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SamplePreprocessing Definition -->
    <xs:complexType name="SamplePreprocessingType">
        <xs:sequence>
            <xs:element name="quenching_method" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method used to quench or stop the reaction in the sample.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="quenching_ratio" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Ratio or proportion of quenching agent to sample.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="treatment_procedure" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional treatment procedures applied to the sample.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about sample preprocessing.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Quantity Definition -->
    <xs:complexType name="QuantityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Storage temperature value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit for the storage temperature (e.g., °C, K).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage_start" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Date when storage under these conditions began or material was
                        received.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="additives" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any additives or stabilizers used during storage (e.g., glycerol,
                        stabilizers, preservatives).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="drying_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to dry the material if stored in dry form (optional,
                        primarily for biocatalysts).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about storage conditions or requirements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum SamplingStrategyType Definition -->
    <xs:simpleType name="SamplingStrategyTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="default"/>
            <xs:enumeration value="specialised"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum FormulationType Definition -->
    <xs:simpleType name="FormulationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dissolved"/>
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="powder"/>
            <xs:enumeration value="solution"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum PhaseType Definition -->
    <xs:simpleType name="PhaseTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="solid"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ReactorType Definition -->
    <xs:simpleType name="ReactorTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="well_mixed"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>