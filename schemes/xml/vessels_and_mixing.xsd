<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Roots -->
    <xs:element name="VesselAndMixing" type="VesselAndMixingType"/>
    <xs:element name="Vessel" type="VesselType"/>
    <xs:element name="Closure" type="ClosureType"/>
    <xs:element name="ReactorSpecifics" type="ReactorSpecificsType"/>
    <xs:element name="GasHandling" type="GasHandlingType"/>
    <xs:element name="Mixing" type="MixingType"/>
    <xs:element name="ShakingMixing" type="ShakingMixingType"/>
    <xs:element name="MechanicalMixing" type="MechanicalMixingType"/>
    <xs:element name="StirBar" type="StirBarType"/>
    <xs:element name="FluidImpelledMixing" type="FluidImpelledMixingType"/>
    <xs:element name="Quantity" type="QuantityType"/>
    <xs:element name="StorageConditions" type="StorageConditionsType"/>

    <!-- VesselAndMixing Definition -->
    <xs:complexType name="VesselAndMixingType">
        <xs:sequence>
            <xs:element name="vessel" type="VesselType">
                <xs:annotation>
                    <xs:documentation>
                        Physical container or reactor used for the enzymatic reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="mixing" type="MixingType">
                <xs:annotation>
                    <xs:documentation>
                        Mixing system and parameters employed during the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes or comments about the vessel and mixing setup.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Vessel Definition -->
    <xs:complexType name="VesselType">
        <xs:sequence>
            <xs:element name="vessel_type" type="VesselTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Type of vessel or reactor configuration used for the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="material" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Material composition of the vessel (e.g., glass, plastic, stainless
                        steel).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="size" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Volume or capacity of the vessel.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="size_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the size.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="geometry" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Geometric shape and dimensions of the vessel.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="closure" type="ClosureType">
                <xs:annotation>
                    <xs:documentation>
                        Sealing and closure system for the vessel.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="supplier" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Manufacturer or supplier of the vessel.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="lot_number" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Batch or lot number for traceability.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reactor_specifics" type="ReactorSpecificsType">
                <xs:annotation>
                    <xs:documentation>
                        Additional reactor-specific configurations and features.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the vessel specifications.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Closure Definition -->
    <xs:complexType name="ClosureType">
        <xs:sequence>
            <xs:element name="closure_type" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Type of closure mechanism (e.g., screw cap, septum, crimp cap).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sealing_material" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Material used for sealing (e.g., PTFE, silicone, rubber).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the closure system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ReactorSpecifics Definition -->
    <xs:complexType name="ReactorSpecificsType">
        <xs:sequence>
            <xs:element name="gas_handling" type="GasHandlingType">
                <xs:annotation>
                    <xs:documentation>
                        Gas supply and handling system for the reactor.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="tubing" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Tubing specifications and connections used in the reactor setup.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="catalyst_localisation" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method or system for localizing or immobilizing the catalyst within
                        the reactor.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_control" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Temperature control and regulation system employed.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- GasHandling Definition -->
    <xs:complexType name="GasHandlingType">
        <xs:sequence>
            <xs:element name="gas_type" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Type of gas used (e.g., nitrogen, oxygen, argon, air).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="supply_method" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method of gas supply (e.g., continuous flow, headspace purging,
                        bubbling).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="supply_rate" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Rate of gas supply or flow into the reactor.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Mixing Definition -->
    <xs:complexType name="MixingType">
        <xs:sequence>
            <xs:element name="mixing_type" type="MixingTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Primary type of mixing employed in the reaction system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="shaking" type="ShakingMixingType">
                <xs:annotation>
                    <xs:documentation>
                        Shaking-based mixing parameters and configuration.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="mechanical" type="MechanicalMixingType">
                <xs:annotation>
                    <xs:documentation>
                        Mechanical stirring parameters and equipment specifications.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="fluid" type="FluidImpelledMixingType">
                <xs:annotation>
                    <xs:documentation>
                        Fluid-driven mixing parameters for flow-based systems.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the mixing strategy and implementation.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ShakingMixing Definition -->
    <xs:complexType name="ShakingMixingType">
        <xs:sequence>
            <xs:element name="shaking_type" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Type of shaking motion (e.g., orbital, linear, reciprocal).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="deflection" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Amplitude or deflection distance of the shaking motion.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="speed" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Frequency or speed of the shaking motion.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="vessel_position" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Orientation or position of the vessel during shaking.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the shaking mixing setup.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- MechanicalMixing Definition -->
    <xs:complexType name="MechanicalMixingType">
        <xs:sequence>
            <xs:element name="stirring_type" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Type of mechanical stirring (e.g., overhead, magnetic, impeller).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="stirrer_material" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Material composition of the stirrer or impeller.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="supplier" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Manufacturer or supplier of the stirring equipment.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="number_of_stirrers" type="xs:integer">
                <xs:annotation>
                    <xs:documentation>
                        Number of stirrers or impellers used in the system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="stirrer_geometry" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Geometric design and shape of the stirrer or impeller.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="blade_pitch_angle" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Angle of the stirrer blades relative to the horizontal plane.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="blade_size" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Dimensions or size of the stirrer blades.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="stirrer_speed" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Rotational speed of the stirrer or impeller.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="height_above_base" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Distance of the stirrer from the bottom of the vessel.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="power_per_volume" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Power input per unit volume of the reaction mixture.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="stir_bar" type="StirBarType">
                <xs:annotation>
                    <xs:documentation>
                        Magnetic stir bar specifications for magnetic stirring systems.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the mechanical mixing setup.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StirBar Definition -->
    <xs:complexType name="StirBarType">
        <xs:sequence>
            <xs:element name="size" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Length and diameter of the magnetic stir bar.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="shape" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Shape of the stir bar (e.g., cylindrical, octagonal, cross-shaped).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- FluidImpelledMixing Definition -->
    <xs:complexType name="FluidImpelledMixingType">
        <xs:sequence>
            <xs:element name="phase_volume_description" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of phase volumes and their distribution in the flow
                        system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="residence_time" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Average residence time of the fluid in the mixing zone.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reynolds_number" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Reynolds number characterizing the flow regime and mixing intensity.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="passive_mixing" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of passive mixing elements or structures used.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="active_mixer" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of active mixing devices or mechanisms employed.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pulsing" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Pulsing or oscillatory flow patterns used to enhance mixing.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the fluid-impelled mixing system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Quantity Definition -->
    <xs:complexType name="QuantityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Storage temperature value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit for the storage temperature (e.g., °C, K).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage_start" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Date when storage under these conditions began or material was
                        received.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="additives" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any additives or stabilizers used during storage (e.g., glycerol,
                        stabilizers, preservatives).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="drying_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to dry the material if stored in dry form (optional,
                        primarily for biocatalysts).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about storage conditions or requirements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum VesselType Definition -->
    <xs:simpleType name="VesselTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="plate"/>
            <xs:enumeration value="stirred_tank"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="vial"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum MixingType Definition -->
    <xs:simpleType name="MixingTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="combined"/>
            <xs:enumeration value="fluid_impelled"/>
            <xs:enumeration value="mechanical"/>
            <xs:enumeration value="none"/>
            <xs:enumeration value="shaking"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum FormulationType Definition -->
    <xs:simpleType name="FormulationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dissolved"/>
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="powder"/>
            <xs:enumeration value="solution"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum PhaseType Definition -->
    <xs:simpleType name="PhaseTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="solid"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ReactorType Definition -->
    <xs:simpleType name="ReactorTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="well_mixed"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>