<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Roots -->
    <xs:element name="ReactionComponent" type="ReactionComponentType"/>
    <xs:element name="ComponentIdentity" type="ComponentIdentityType"/>
    <xs:element name="AmountConcentration" type="AmountConcentrationType"/>
    <xs:element name="Provenance" type="ProvenanceType"/>
    <xs:element name="SolubilityLimit" type="SolubilityLimitType"/>
    <xs:element name="Quantity" type="QuantityType"/>
    <xs:element name="StorageConditions" type="StorageConditionsType"/>

    <!-- ReactionComponent Definition -->
    <xs:complexType name="ReactionComponentType">
        <xs:sequence>
            <xs:element name="identity" type="ComponentIdentityType">
                <xs:annotation>
                    <xs:documentation>
                        Chemical identification and characterization of the component.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="role" type="ComponentRoleType">
                <xs:annotation>
                    <xs:documentation>
                        What this component does in the reaction (substrate, cosubstrate,
                        salt, ...).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amount" type="AmountConcentrationType">
                <xs:annotation>
                    <xs:documentation>
                        Quantity or concentration of the component used in the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="provenance" type="ProvenanceType">
                <xs:annotation>
                    <xs:documentation>
                        Source and supplier information for the component.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="solubility" type="SolubilityLimitType">
                <xs:annotation>
                    <xs:documentation>
                        Solubility characteristics of the component under reaction conditions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage" type="StorageConditionsType">
                <xs:annotation>
                    <xs:documentation>
                        Storage requirements and conditions for the component.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes or comments about the component.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ComponentIdentity Definition -->
    <xs:complexType name="ComponentIdentityType">
        <xs:sequence>
            <xs:element name="name" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Common or systematic name of the component.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="smiles" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        SMILES (Simplified Molecular Input Line Entry System) notation for the
                        chemical structure.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="identifiers" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        One or more identifiers like CAS, PubChem CID, InChI, etc.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purity" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Purity of the component as a percentage or fraction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="formulation" type="FormulationTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Physical form or formulation of the component (powder, liquid,
                        solution, etc.).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- AmountConcentration Definition -->
    <xs:complexType name="AmountConcentrationType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the amount or concentration.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the amount or concentration.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Provenance Definition -->
    <xs:complexType name="ProvenanceType">
        <xs:sequence>
            <xs:element name="supplier" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Supplier/manufacturer or &quot;prepared in lab&quot;; include product
                        code or citation if applicable.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SolubilityLimit Definition -->
    <xs:complexType name="SolubilityLimitType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the solubility limit.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the solubility limit.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Quantity Definition -->
    <xs:complexType name="QuantityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Storage temperature value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit for the storage temperature (e.g., °C, K).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage_start" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Date when storage under these conditions began or material was
                        received.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="additives" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any additives or stabilizers used during storage (e.g., glycerol,
                        stabilizers, preservatives).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="drying_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to dry the material if stored in dry form (optional,
                        primarily for biocatalysts).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about storage conditions or requirements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum ComponentRole Definition -->
    <xs:simpleType name="ComponentRoleType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="buffer"/>
            <xs:enumeration value="coenzyme"/>
            <xs:enumeration value="cofactor"/>
            <xs:enumeration value="cosubstrate"/>
            <xs:enumeration value="ion"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="product"/>
            <xs:enumeration value="salt"/>
            <xs:enumeration value="solvent"/>
            <xs:enumeration value="substrate"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum FormulationType Definition -->
    <xs:simpleType name="FormulationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dissolved"/>
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="powder"/>
            <xs:enumeration value="solution"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum PhaseType Definition -->
    <xs:simpleType name="PhaseTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="solid"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ReactorType Definition -->
    <xs:simpleType name="ReactorTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="well_mixed"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>