<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Roots -->
    <xs:element name="ReactionConditions" type="ReactionConditionsType"/>
    <xs:element name="ReactorSetup" type="ReactorSetupType"/>
    <xs:element name="FlowConditions" type="FlowConditionsType"/>
    <xs:element name="ReactionSystem" type="ReactionSystemType"/>
    <xs:element name="MonoliquidSystem" type="MonoliquidSystemType"/>
    <xs:element name="MultiphasicSystem" type="MultiphasicSystemType"/>
    <xs:element name="Phase" type="PhaseType"/>
    <xs:element name="TemperatureProfile" type="TemperatureProfileType"/>
    <xs:element name="ProfilePoint" type="ProfilePointType"/>
    <xs:element name="Gradient" type="GradientType"/>
    <xs:element name="PHProfile" type="PHProfileType"/>
    <xs:element name="PHPoint" type="PHPointType"/>
    <xs:element name="PHGradient" type="PHGradientType"/>
    <xs:element name="PHDetection" type="PHDetectionType"/>
    <xs:element name="Quantity" type="QuantityType"/>
    <xs:element name="StorageConditions" type="StorageConditionsType"/>

    <!-- ReactionConditions Definition -->
    <xs:complexType name="ReactionConditionsType">
        <xs:sequence>
            <xs:element name="reactor" type="ReactorSetupType">
                <xs:annotation>
                    <xs:documentation>
                        Configuration and specifications of the reactor used for the
                        biocatalytic reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="system" type="ReactionSystemType">
                <xs:annotation>
                    <xs:documentation>
                        Characterization of the reaction system as monoliquid or multiphasic.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="phases">
                <xs:annotation>
                    <xs:documentation>
                        Individual phases present in the reaction system (liquid, solid, gas).
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Phase" type="PhaseType" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="temperature" type="TemperatureProfileType">
                <xs:annotation>
                    <xs:documentation>
                        Temperature conditions throughout the reaction, which can be constant,
                        event-based, or follow a gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="pH" type="PHProfileType">
                <xs:annotation>
                    <xs:documentation>
                        pH conditions throughout the reaction, which can be constant, event-
                        based, or follow a gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes or comments about the reaction conditions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ReactorSetup Definition -->
    <xs:complexType name="ReactorSetupType">
        <xs:sequence>
            <xs:element name="reactor_type" type="ReactorTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Type of reactor configuration used (well-mixed or tubular flow).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="flow" type="FlowConditionsType">
                <xs:annotation>
                    <xs:documentation>
                        Flow rate specifications for continuous or fed-batch operations.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the reactor setup.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- FlowConditions Definition -->
    <xs:complexType name="FlowConditionsType">
        <xs:sequence>
            <xs:element name="flow_rate" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the flow rate.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="flow_rate_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the flow rate.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ReactionSystem Definition -->
    <xs:complexType name="ReactionSystemType">
        <xs:sequence>
            <xs:element name="system_type" type="SystemTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Classification of the system as monoliquid or multiphasic.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="monoliquid" type="MonoliquidSystemType">
                <xs:annotation>
                    <xs:documentation>
                        Specifications for single-phase liquid systems.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="multiphasic" type="MultiphasicSystemType">
                <xs:annotation>
                    <xs:documentation>
                        Specifications for systems containing multiple phases.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the reaction system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- MonoliquidSystem Definition -->
    <xs:complexType name="MonoliquidSystemType">
        <xs:sequence>
            <xs:element name="solvent_description" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Detailed description of the solvent or solvent mixture used.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ionic_strength" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Ionic strength of the solution, affecting enzyme activity and
                        stability.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="further_additives" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of any additional additives present in the system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the monoliquid system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- MultiphasicSystem Definition -->
    <xs:complexType name="MultiphasicSystemType">
        <xs:sequence>
            <xs:element name="phases_number" type="xs:integer">
                <xs:annotation>
                    <xs:documentation>
                        Total number of distinct phases present in the system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the multiphasic system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Phase Definition -->
    <xs:complexType name="PhaseType">
        <xs:sequence>
            <xs:element name="phase_type" type="PhaseTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Physical state of the phase (liquid, solid, or gas).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="material_description" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Detailed description of the materials comprising this phase.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amount" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Quantity of material in this phase.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="amount_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the amount.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about this specific phase.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- TemperatureProfile Definition -->
    <xs:complexType name="TemperatureProfileType">
        <xs:sequence>
            <xs:element name="profile_type" type="ProfileTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Type of temperature profile used (constant, event-based, multipoint,
                        or gradient).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for temperature values.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="constant_temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Temperature value for constant temperature profiles.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="profile_points">
                <xs:annotation>
                    <xs:documentation>
                        Series of temperature points for event-based or multipoint profiles.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ProfilePoint" type="ProfilePointType" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="gradient" type="GradientType">
                <xs:annotation>
                    <xs:documentation>
                        Gradient specifications for temperature ramp profiles.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the temperature profile.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ProfilePoint Definition -->
    <xs:complexType name="ProfilePointType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Temperature value at this point.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="time" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Time at which this temperature is measured or set.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="time_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the time value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="event_description" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of any specific event associated with this temperature
                        point.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Gradient Definition -->
    <xs:complexType name="GradientType">
        <xs:sequence>
            <xs:element name="start_value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Initial temperature value at the beginning of the gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="end_value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Final temperature value at the end of the gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="length" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Duration or distance over which the gradient is applied.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="length_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the gradient length (time or distance).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="measurement_points" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of how temperature is measured along the gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- PHProfile Definition -->
    <xs:complexType name="PHProfileType">
        <xs:sequence>
            <xs:element name="profile_type" type="ProfileTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Type of pH profile used (constant, event-based, multipoint, or
                        gradient).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="constant_pH" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        pH value for constant pH profiles.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="profile_points">
                <xs:annotation>
                    <xs:documentation>
                        Series of pH points for event-based or multipoint profiles.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="PHPoint" type="PHPointType" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="gradient" type="PHGradientType">
                <xs:annotation>
                    <xs:documentation>
                        Gradient specifications for pH ramp profiles.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="detection" type="PHDetectionType">
                <xs:annotation>
                    <xs:documentation>
                        Methods and conditions used for pH detection and measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the pH profile.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- PHPoint Definition -->
    <xs:complexType name="PHPointType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        pH value at this point.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="time" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Time at which this pH is measured or set.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="time_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the time value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="event_description" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of any specific event associated with this pH point.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- PHGradient Definition -->
    <xs:complexType name="PHGradientType">
        <xs:sequence>
            <xs:element name="start_value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Initial pH value at the beginning of the gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="end_value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Final pH value at the end of the gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="length" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Duration over which the pH gradient is applied.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="length_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the gradient duration.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="measurement_points" type="xs:float"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Measurement points along the gradient.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- PHDetection Definition -->
    <xs:complexType name="PHDetectionType">
        <xs:sequence>
            <xs:element name="detected_when" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Timing or conditions under which pH is detected.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="detected_how" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method or instrument used for pH detection.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Temperature at which pH measurements are calibrated or performed.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the calibration temperature.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="calibration_pH_electrode" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Details about pH electrode calibration procedures and standards.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Quantity Definition -->
    <xs:complexType name="QuantityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Storage temperature value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit for the storage temperature (e.g., °C, K).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage_start" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Date when storage under these conditions began or material was
                        received.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="additives" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any additives or stabilizers used during storage (e.g., glycerol,
                        stabilizers, preservatives).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="drying_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to dry the material if stored in dry form (optional,
                        primarily for biocatalysts).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about storage conditions or requirements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum SystemType Definition -->
    <xs:simpleType name="SystemTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="monoliquid"/>
            <xs:enumeration value="multiphasic"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ProfileType Definition -->
    <xs:simpleType name="ProfileTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="constant"/>
            <xs:enumeration value="event_based"/>
            <xs:enumeration value="gradient"/>
            <xs:enumeration value="multipoint"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum FormulationType Definition -->
    <xs:simpleType name="FormulationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dissolved"/>
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="powder"/>
            <xs:enumeration value="solution"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum PhaseType Definition -->
    <xs:simpleType name="PhaseTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="solid"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ReactorType Definition -->
    <xs:simpleType name="ReactorTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="well_mixed"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>