<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Roots -->
    <xs:element name="ExperimentalResults" type="ExperimentalResultsType"/>
    <xs:element name="KineticResults" type="KineticResultsType"/>
    <xs:element name="InhibitionParameters" type="InhibitionParametersType"/>
    <xs:element name="YieldAndConversionResults" type="YieldAndConversionResultsType"/>
    <xs:element name="ActivityResults" type="ActivityResultsType"/>
    <xs:element name="SelectivityResults" type="SelectivityResultsType"/>
    <xs:element name="ThermodynamicResults" type="ThermodynamicResultsType"/>
    <xs:element name="Quantity" type="QuantityType"/>
    <xs:element name="StorageConditions" type="StorageConditionsType"/>

    <!-- ExperimentalResults Definition -->
    <xs:complexType name="ExperimentalResultsType">
        <xs:sequence>
            <xs:element name="kinetics" type="KineticResultsType">
                <xs:annotation>
                    <xs:documentation>
                        Kinetic parameters and enzyme behavior characteristics.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="yield_and_conversion" type="YieldAndConversionResultsType">
                <xs:annotation>
                    <xs:documentation>
                        Product yield and substrate conversion measurements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="activity" type="ActivityResultsType">
                <xs:annotation>
                    <xs:documentation>
                        Enzyme activity and initial reaction rate data.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="selectivity" type="SelectivityResultsType">
                <xs:annotation>
                    <xs:documentation>
                        Selectivity measurements including stereoselectivity and
                        enantioselectivity.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="thermodynamics" type="ThermodynamicResultsType">
                <xs:annotation>
                    <xs:documentation>
                        Thermodynamic parameters of the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes or comments about the experimental results.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- KineticResults Definition -->
    <xs:complexType name="KineticResultsType">
        <xs:sequence>
            <xs:element name="michaelis_constant" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Michaelis constant (Km) representing the substrate concentration at
                        half-maximum reaction rate.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="maximum_reaction_rate" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Maximum reaction rate (Vmax) achieved under saturating substrate
                        conditions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="turnover_number" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Turnover number (kcat) representing the maximum number of substrate
                        molecules converted per enzyme molecule per
                        unit time.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="catalytic_efficiency" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Catalytic efficiency (kcat/Km) indicating the enzyme&apos;s
                        effectiveness at low substrate concentrations.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="dissociation_constant" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Dissociation constant (Kd) for enzyme-substrate or enzyme-inhibitor
                        binding.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="inhibition" type="InhibitionParametersType">
                <xs:annotation>
                    <xs:documentation>
                        Parameters describing enzyme inhibition characteristics.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="hill_coefficient" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Hill coefficient indicating cooperativity in substrate binding or
                        enzyme kinetics.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enzyme_stability" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Qualitative or quantitative description of enzyme stability under
                        reaction conditions.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about kinetic measurements or observations.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- InhibitionParameters Definition -->
    <xs:complexType name="InhibitionParametersType">
        <xs:sequence>
            <xs:element name="inhibition_type" type="InhibitionTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Type of inhibition mechanism observed.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="inhibition_constant" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Inhibition constant (Ki) quantifying the strength of inhibitor
                        binding.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- YieldAndConversionResults Definition -->
    <xs:complexType name="YieldAndConversionResultsType">
        <xs:sequence>
            <xs:element name="product_yield" type="xs:float"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Product yield as percentage or fraction of theoretical maximum.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="space_time_yield" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Space-time yield representing product formation rate per unit reactor
                        volume.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="conversion" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Substrate conversion as percentage or fraction of initial substrate
                        consumed.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about yield and conversion measurements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ActivityResults Definition -->
    <xs:complexType name="ActivityResultsType">
        <xs:sequence>
            <xs:element name="specific_activity" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Specific activity representing enzyme activity per unit mass of enzyme
                        protein.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="initial_reaction_rate" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Initial reaction rate measured at the beginning of the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about activity measurements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SelectivityResults Definition -->
    <xs:complexType name="SelectivityResultsType">
        <xs:sequence>
            <xs:element name="stereoselectivity" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Qualitative or quantitative description of stereoselectivity in the
                        reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enantioselectivity" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Enantioselectivity ratio (E-value) indicating preference for one
                        enantiomer over another.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enantiomeric_excess" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Enantiomeric excess (ee) as percentage indicating optical purity of
                        the product.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="diastereomeric_excess" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Diastereomeric excess (de) as percentage for reactions producing
                        diastereomers.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="isomeric_content" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Content or ratio of specific isomers in the product mixture.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="chemoselectivity" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of chemoselectivity when multiple reaction pathways are
                        possible.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="regioselectivity" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Description of regioselectivity indicating preference for specific
                        reaction sites.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about selectivity measurements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ThermodynamicResults Definition -->
    <xs:complexType name="ThermodynamicResultsType">
        <xs:sequence>
            <xs:element name="gibbs_free_energy_change" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Gibbs free energy change (ΔG) for the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="enthalpy_change" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Enthalpy change (ΔH) for the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="entropy_change" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Entropy change (ΔS) for the reaction.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about thermodynamic measurements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Quantity Definition -->
    <xs:complexType name="QuantityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Storage temperature value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit for the storage temperature (e.g., °C, K).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage_start" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Date when storage under these conditions began or material was
                        received.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="additives" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any additives or stabilizers used during storage (e.g., glycerol,
                        stabilizers, preservatives).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="drying_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to dry the material if stored in dry form (optional,
                        primarily for biocatalysts).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about storage conditions or requirements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum InhibitionType Definition -->
    <xs:simpleType name="InhibitionTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="competitive"/>
            <xs:enumeration value="irreversible"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="non_competitive"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="uncompetitive"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum FormulationType Definition -->
    <xs:simpleType name="FormulationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dissolved"/>
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="powder"/>
            <xs:enumeration value="solution"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum PhaseType Definition -->
    <xs:simpleType name="PhaseTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="solid"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ReactorType Definition -->
    <xs:simpleType name="ReactorTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="well_mixed"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>