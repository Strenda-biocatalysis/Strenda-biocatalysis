<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Roots -->
    <xs:element name="Biocatalyst" type="BiocatalystType"/>
    <xs:element name="BiocatalystIdentity" type="BiocatalystIdentityType"/>
    <xs:element name="SequenceInfo" type="SequenceInfoType"/>
    <xs:element name="BiocatalystSource" type="BiocatalystSourceType"/>
    <xs:element name="PurchasedDetails" type="PurchasedDetailsType"/>
    <xs:element name="SelfProducedDetails" type="SelfProducedDetailsType"/>
    <xs:element name="BiocatalystApplication" type="BiocatalystApplicationType"/>
    <xs:element name="Concentration" type="ConcentrationType"/>
    <xs:element name="Activity" type="ActivityType"/>
    <xs:element name="ApplicationWorkflowDetails" type="ApplicationWorkflowDetailsType"/>
    <xs:element name="Immobilization" type="ImmobilizationType"/>
    <xs:element name="Quantity" type="QuantityType"/>
    <xs:element name="StorageConditions" type="StorageConditionsType"/>

    <!-- Biocatalyst Definition -->
    <xs:complexType name="BiocatalystType">
        <xs:sequence>
            <xs:element name="identity" type="BiocatalystIdentityType">
                <xs:annotation>
                    <xs:documentation>
                        Essential identifying information about the biocatalyst including
                        name, EC number, molecular properties, and
                        sequence data.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="source_type" type="BiocatalystSourceTypeType"/>
            <xs:element name="source" type="BiocatalystSourceType">
                <xs:annotation>
                    <xs:documentation>
                        Information about how the biocatalyst was obtained, whether purchased
                        commercially or produced in-house.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="application" type="BiocatalystApplicationType">
                <xs:annotation>
                    <xs:documentation>
                        Details about how the biocatalyst is applied in the reaction,
                        including concentration, activity, and
                        workflow specifics.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="immobilization" type="ImmobilizationType">
                <xs:annotation>
                    <xs:documentation>
                        Information about whether and how the biocatalyst is immobilized on a
                        support material.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage" type="StorageConditionsType">
                <xs:annotation>
                    <xs:documentation>
                        Conditions under which the biocatalyst is stored to maintain its
                        activity and stability.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes or comments about the biocatalyst that don&apos;t fit
                        in other categories.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- BiocatalystIdentity Definition -->
    <xs:complexType name="BiocatalystIdentityType">
        <xs:sequence>
            <xs:element name="name" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        The name of the biocatalyst, which can be the trivial name, systematic
                        name, or trade name.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="ec_number" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        The Enzyme Commission (EC) number that classifies the enzyme according
                        to the reaction it catalyzes.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="molecular_weight" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        The molecular weight of the enzyme in the specified units.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="molecular_weight_unit" type="MolecularWeightUnitType">
                <xs:annotation>
                    <xs:documentation>
                        The unit of measurement for the molecular weight (e.g., kDa, Da).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="catalyzed_reaction" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Description of the specific reaction or type of reaction catalyzed by
                        this enzyme.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sequences" type="SequenceInfoType">
                <xs:annotation>
                    <xs:documentation>
                        Amino acid and/or DNA sequence information for the enzyme.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="origin_organism" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        The organism from which the enzyme was originally derived or isolated.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="production_organism" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        The organism used to produce the enzyme (may differ from origin
                        organism for recombinant enzymes).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="posttranslational_modification" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any post-translational modifications present on the enzyme that may
                        affect its activity or properties.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SequenceInfo Definition -->
    <xs:complexType name="SequenceInfoType">
        <xs:sequence>
            <xs:element name="sequence_amino_acid" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        The amino acid sequence of the enzyme in single-letter code format.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="sequence_dna" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        The DNA sequence encoding the enzyme.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- BiocatalystSource Definition -->
    <xs:complexType name="BiocatalystSourceType">
        <xs:sequence>
            <xs:element name="source_type" type="BiocatalystSourceTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Whether the biocatalyst was purchased from a supplier or produced
                        in-house.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="supplier" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Name of the commercial supplier or source of the biocatalyst.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purchased_details" type="PurchasedDetailsType">
                <xs:annotation>
                    <xs:documentation>
                        Specific details relevant to commercially purchased biocatalysts.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="self_produced_details" type="SelfProducedDetailsType">
                <xs:annotation>
                    <xs:documentation>
                        Specific details relevant to biocatalysts produced in-house.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- PurchasedDetails Definition -->
    <xs:complexType name="PurchasedDetailsType">
        <xs:sequence>
            <xs:element name="reference" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Product code, catalog number, or other reference identifier from the
                        supplier.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purity" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Purity of the purchased biocatalyst as specified by the supplier,
                        typically as a percentage.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purity_specification" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method or specification used to determine the purity (e.g., SDS-PAGE,
                        activity assay).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="formulation" type="FormulationTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Physical form of the purchased biocatalyst (dissolved, powder, etc.).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- SelfProducedDetails Definition -->
    <xs:complexType name="SelfProducedDetailsType">
        <xs:sequence>
            <xs:element name="sequence_plasmid" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Sequence of the plasmid used for enzyme expression.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="plasmid_specifications" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Details about the plasmid construction, including vector backbone,
                        promoter, and other relevant features.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purification_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method(s) used to purify the enzyme after expression.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purity" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Achieved purity of the self-produced biocatalyst, typically as a
                        percentage.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purity_specification" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method used to determine the purity of the self-produced enzyme.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="formulation" type="FormulationTypeType">
                <xs:annotation>
                    <xs:documentation>
                        Physical form of the self-produced biocatalyst after purification
                        and processing.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- BiocatalystApplication Definition -->
    <xs:complexType name="BiocatalystApplicationType">
        <xs:sequence>
            <xs:element name="application_type" type="BiocatalystApplicationTypeType">
                <xs:annotation>
                    <xs:documentation>
                        The form in which the biocatalyst is applied (purified enzyme, crude
                        extract, whole cells, etc.).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="concentration">
                <xs:annotation>
                    <xs:documentation>
                        Concentration of the biocatalyst in the reaction mixture.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Concentration" type="ConcentrationType" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="activity">
                <xs:annotation>
                    <xs:documentation>
                        Measured enzymatic activity of the biocatalyst under the reaction
                        conditions.
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Activity" type="ActivityType" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:element name="workflow_details" type="ApplicationWorkflowDetailsType">
                <xs:annotation>
                    <xs:documentation>
                        Specific workflow steps and methods used in applying the biocatalyst.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Concentration Definition -->
    <xs:complexType name="ConcentrationType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the concentration.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the concentration (e.g., mg/mL, µM, U/mL).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="determination_method" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method used to determine or calculate the concentration.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Activity Definition -->
    <xs:complexType name="ActivityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measured activity.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the activity (e.g., U/mg, µmol/min/mg).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="determination_method" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Assay method used to measure the enzymatic activity.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- ApplicationWorkflowDetails Definition -->
    <xs:complexType name="ApplicationWorkflowDetailsType">
        <xs:sequence>
            <xs:element name="cell_disruption_process" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method used to disrupt cells if working with whole cell preparations.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="harvesting_method" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method used to harvest cells or enzyme from the production system.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="separation_method" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Method used to separate the biocatalyst from other components.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="source_of_cellfree_extract" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Details about the source and preparation of cell-free extracts if
                        applicable.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Immobilization Definition -->
    <xs:complexType name="ImmobilizationType">
        <xs:sequence>
            <xs:element name="immobilized" type="xs:boolean">
                <xs:annotation>
                    <xs:documentation>
                        Whether the biocatalyst is immobilized (true) or used in free form
                        (false).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="biocatalyst_state" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Physical state of the biocatalyst during immobilization (e.g.,
                        purified enzyme, crude extract).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="immobilisation_chemistry" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Chemical method or mechanism used for immobilization (e.g., covalent
                        binding, adsorption, entrapment).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="carrier_material" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Material used as the solid support for immobilization.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="linkers" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Chemical linkers or spacers used between the enzyme and carrier
                        material.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="immobilisation_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Detailed procedure used for the immobilization process.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="purification_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to purify or wash the immobilized biocatalyst.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="loading" type="ConcentrationType">
                <xs:annotation>
                    <xs:documentation>
                        Amount of enzyme loaded onto the carrier material.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about the immobilization process or properties.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Quantity Definition -->
    <xs:complexType name="QuantityType">
        <xs:sequence>
            <xs:element name="value" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Numerical value of the measurement.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit of measurement for the value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- StorageConditions Definition -->
    <xs:complexType name="StorageConditionsType">
        <xs:sequence>
            <xs:element name="temperature" type="xs:float">
                <xs:annotation>
                    <xs:documentation>
                        Storage temperature value.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="temperature_unit" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Unit for the storage temperature (e.g., °C, K).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="storage_start" type="xs:date">
                <xs:annotation>
                    <xs:documentation>
                        Date when storage under these conditions began or material was
                        received.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="additives" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Any additives or stabilizers used during storage (e.g., glycerol,
                        stabilizers, preservatives).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="drying_method" type="xs:string"  minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>
                        Method used to dry the material if stored in dry form (optional,
                        primarily for biocatalysts).
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="xs:string">
                <xs:annotation>
                    <xs:documentation>
                        Additional notes about storage conditions or requirements.
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Enum BiocatalystSourceType Definition -->
    <xs:simpleType name="BiocatalystSourceTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="purchased"/>
            <xs:enumeration value="self_produced"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum BiocatalystApplicationType Definition -->
    <xs:simpleType name="BiocatalystApplicationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="cell_free"/>
            <xs:enumeration value="crude_cell_extract"/>
            <xs:enumeration value="purified"/>
            <xs:enumeration value="secreted"/>
            <xs:enumeration value="whole_cell"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum MolecularWeightUnit Definition -->
    <xs:simpleType name="MolecularWeightUnitType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Da"/>
            <xs:enumeration value="kDa"/>
            <xs:enumeration value="other"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum FormulationType Definition -->
    <xs:simpleType name="FormulationTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="dissolved"/>
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="powder"/>
            <xs:enumeration value="solution"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum PhaseType Definition -->
    <xs:simpleType name="PhaseTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="gas"/>
            <xs:enumeration value="liquid"/>
            <xs:enumeration value="mixed"/>
            <xs:enumeration value="other"/>
            <xs:enumeration value="solid"/>
        </xs:restriction>
    </xs:simpleType>
    <!-- Enum ReactorType Definition -->
    <xs:simpleType name="ReactorTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="other"/>
            <xs:enumeration value="tubular_flow"/>
            <xs:enumeration value="well_mixed"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>